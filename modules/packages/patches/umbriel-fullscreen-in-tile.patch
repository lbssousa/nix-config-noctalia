diff --git a/tests/harness/checks/layout/fullscreen_in_tile.sh b/tests/harness/checks/layout/fullscreen_in_tile.sh
new file mode 100755
index 00000000..46c1d6b7
--- /dev/null
+++ b/tests/harness/checks/layout/fullscreen_in_tile.sh
@@ -0,0 +1,168 @@
+#!/usr/bin/env bash
+# window-toggle-fullscreen-in-tile tells the client it is fullscreen while it keeps its tile: the configure carries the
+# fullscreen state at the tile size, and the neighbor keeps its box. The client's own unfullscreen ends the mode, real
+# fullscreen takes over from it, and the action brings a fullscreen window back into its tile still fullscreen.
+set -euo pipefail
+
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+readonly CLIENT="${UMBRIEL_UNMAP_CLIENT:-./build-debug/tests/unmap-client}"
+readonly CONTROL_FIFO="$UMBRIEL_RUNTIME_DIR/fullscreen-in-tile-control"
+readonly CLIENT_LOG="$UMBRIEL_RUNTIME_DIR/fullscreen-in-tile.log"
+
+windows() { "$UMBRIEL" windows --json; }
+
+field_of() {
+  windows | jq -r --arg title "$1" --arg field "$2" '.[] | select(.title == $title) | .[$field]'
+}
+
+box_of() {
+  windows | jq -r --arg title "$1" '.[] | select(.title == $title) | "\(.x),\(.y) \(.w)x\(.h)"'
+}
+
+wait_for_count() {
+  local want=$1
+  for _ in $(seq 60); do
+    [[ $(windows | jq 'length') -eq $want ]] && return 0
+    sleep 0.05
+  done
+  echo "expected $want windows, got: $(windows)"
+  return 1
+}
+
+wait_for_field() {
+  local title=$1 field=$2 expected=$3 actual=
+  for _ in $(seq 80); do
+    actual=$(field_of "$title" "$field")
+    [[ $actual == "$expected" ]] && return 0
+    sleep 0.05
+  done
+  echo "expected '$title' field '$field' to be '$expected', got '$actual': $(windows)"
+  return 1
+}
+
+# The latest configure the client saw, as "<width>x<height> <fullscreen|windowed>".
+wait_for_configured() {
+  local want=$1 configured=
+  for _ in $(seq 80); do
+    configured=$(grep '^configured-state=' "$CLIENT_LOG" | tail -1 || true)
+    [[ ${configured#configured-state=} == "$want" ]] && return 0
+    sleep 0.05
+  done
+  echo "expected latest client configure to be '$want', got '${configured:-none}': $(cat "$CLIENT_LOG")"
+  return 1
+}
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[layout]
+mode = "dwindle"
+
+[animation]
+duration_ms = 1
+curve = "linear"
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+mkfifo "$CONTROL_FIFO"
+exec {control_fd}<>"$CONTROL_FIFO"
+FULLSCREEN_ON_STDIN=1 LOG_CONFIGURES=1 RESIZE_FILL_COLOR=0xFF5577AA "$CLIENT" in-tile-left 400 300 \
+  <&"$control_fd" > "$CLIENT_LOG" 2>&1 &
+wait_for_count 1
+RESIZE_FILL_COLOR=0xFF77AA55 "$CLIENT" in-tile-right 400 300 > /dev/null 2>&1 &
+wait_for_count 2
+"$UMBRIEL" settle
+
+left_id=$(field_of in-tile-left id)
+"$UMBRIEL" msg "window-focus:$left_id" > /dev/null
+wait_for_field in-tile-left active true
+left_box=$(box_of in-tile-left)
+right_box=$(box_of in-tile-right)
+left_size=${left_box#* }
+wait_for_configured "$left_size windowed"
+
+# The mode keeps both tiles where they are and only flips the client's state.
+"$UMBRIEL" msg window-toggle-fullscreen-in-tile > /dev/null
+wait_for_field in-tile-left fullscreen_in_tile true
+wait_for_configured "$left_size fullscreen"
+[[ $(field_of in-tile-left fullscreen) == false ]] || {
+  echo "fullscreen in the tile reported compositor fullscreen: $(windows)"
+  exit 1
+}
+"$UMBRIEL" settle
+[[ $(box_of in-tile-left) == "$left_box" && $(box_of in-tile-right) == "$right_box" ]] || {
+  echo "fullscreen in the tile moved a tile: left $left_box -> $(box_of in-tile-left)," \
+    "right $right_box -> $(box_of in-tile-right)"
+  exit 1
+}
+
+# A fullscreen request while in the mode leaves it in place; the client's unfullscreen ends it.
+printf f >&"$control_fd"
+sleep 0.2 # real time: proves the request changes nothing
+[[ $(field_of in-tile-left fullscreen) == false && $(field_of in-tile-left fullscreen_in_tile) == true ]] || {
+  echo "client fullscreen request left the tile: $(windows)"
+  exit 1
+}
+printf u >&"$control_fd"
+wait_for_field in-tile-left fullscreen_in_tile false
+wait_for_configured "$left_size windowed"
+
+# Real fullscreen takes over from the mode, and the action brings the window back to its tile still fullscreen.
+"$UMBRIEL" msg window-toggle-fullscreen-in-tile > /dev/null
+wait_for_configured "$left_size fullscreen"
+"$UMBRIEL" msg window-toggle-fullscreen > /dev/null
+wait_for_field in-tile-left fullscreen true
+wait_for_field in-tile-left fullscreen_in_tile false
+wait_for_configured "${OUTPUT_W}x${OUTPUT_H} fullscreen"
+"$UMBRIEL" msg window-toggle-fullscreen-in-tile > /dev/null
+wait_for_field in-tile-left fullscreen false
+wait_for_field in-tile-left fullscreen_in_tile true
+wait_for_configured "$left_size fullscreen"
+
+# Leaving real fullscreen entered from the mode exits both.
+"$UMBRIEL" msg window-toggle-fullscreen > /dev/null
+wait_for_field in-tile-left fullscreen true
+"$UMBRIEL" msg window-toggle-fullscreen > /dev/null
+wait_for_field in-tile-left fullscreen false
+wait_for_configured "$left_size windowed"
+[[ $(field_of in-tile-left fullscreen_in_tile) == false ]] || {
+  echo "leaving real fullscreen kept the window fullscreen in its tile: $(windows)"
+  exit 1
+}
+
+# default_fullscreen_in_tile opens a window in the mode: the configure before its first buffer already carries the
+# fullscreen state, and the window stays in the layout. Real fullscreen from default_fullscreen wins over it.
+readonly RULE_LOG="$UMBRIEL_RUNTIME_DIR/fullscreen-in-tile-rule.log"
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[[window_rule]]
+match.title = "^in-tile-rule"
+default_fullscreen_in_tile = true
+
+[[window_rule]]
+match.title = "^in-tile-rule-real$"
+default_fullscreen = true
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+LOG_CONFIGURES=1 "$CLIENT" in-tile-rule 400 300 > "$RULE_LOG" 2>&1 &
+wait_for_count 3
+wait_for_field in-tile-rule fullscreen_in_tile true
+[[ $(field_of in-tile-rule fullscreen) == false ]] || {
+  echo "default_fullscreen_in_tile opened in compositor fullscreen: $(windows)"
+  exit 1
+}
+first_state=$(grep -m1 -E '^(configured-state=|mapped$)' "$RULE_LOG" || true)
+[[ $first_state == configured-state=*" fullscreen" ]] || {
+  echo "default_fullscreen_in_tile did not configure fullscreen before the first buffer: $(cat "$RULE_LOG")"
+  exit 1
+}
+
+"$CLIENT" in-tile-rule-real 400 300 > /dev/null 2>&1 &
+wait_for_count 4
+wait_for_field in-tile-rule-real fullscreen true
+[[ $(field_of in-tile-rule-real fullscreen_in_tile) == false ]] || {
+  echo "default_fullscreen_in_tile overrode default_fullscreen: $(windows)"
+  exit 1
+}
+
+echo "fullscreen in the tile keeps the layout box, follows client and compositor fullscreen, and opens from a rule"
