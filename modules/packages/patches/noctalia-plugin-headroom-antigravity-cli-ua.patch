+-- The quota endpoint returns the Gemini groups (Gemini Models and Gemini 4
+-- Argon) only to clients that identify as the CLI; a bare "antigravity" gets
+-- just the Claude & GPT group. Version from `agy --version`, asked once.
+local KNOWN_CLI_VERSION = "1.5.3"
+local cliVersion: string? = nil
+local versionAsked = false
+
+local function userAgent(ctx): string
+  if not versionAsked then
+    versionAsked = true
+    local agy = agyCommand(ctx)
+    if agy then
+      ctx.run({ "env", "AGY_CLI_DISABLE_AUTO_UPDATE=true", agy, "--version" }, 5000, function(result)
+        cliVersion = result and result.exitCode == 0
+          and result.stdout:match("^%s*(%d+%.%d+%.%d+)") or nil
+      end)
+    end
+  end
+  return `antigravity/cli/{cliVersion or KNOWN_CLI_VERSION}`
+end
+
 local function isFresh(session: Session?, now: number): boolean
