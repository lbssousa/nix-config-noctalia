+    if (m_configOptions.itemFrame) {
+      // Per-icon frame (fill + border from the palette) so light icons stay readable on a
+      // light bar. Drawn below the hover highlight (z -1) and the active indicator.
+      auto frame = ui::box({
+          .fill = m_configOptions.itemFrameColor,
+          .border = m_configOptions.itemFrameBorderColor,
+          .borderWidth = std::max(1.0F, Style::borderWidth * m_contentScale),
+          .radius = resolvedBarCapsuleRadius(tileWidthWithTitle, tileSize),
+          .width = tileWidthWithTitle,
+          .height = tileSize,
+          .configure = [](Box& box) { box.setZIndex(-2); },
+      });
+      frame->setHitTestVisible(false);
+      area->addChild(std::move(frame));
+    }
     attachHover(*area, tileWidthWithTitle, tileSize);
     return area;
   };
