diff --git c/src/prompt_client/askpass_main.cpp w/src/prompt_client/askpass_main.cpp
new file mode 100644
index 000000000..9319c9c69
--- /dev/null
+++ w/src/prompt_client/askpass_main.cpp
@@ -0,0 +1,140 @@
+// noctalia-askpass: SSH_ASKPASS for ssh, ssh-add and git. The prompt comes in argv[1] and
+// SSH_ASKPASS_PROMPT selects the kind ("confirm", "none" or a secret). Answers are printed on
+// stdout; cancelling exits with status 1. Talks to the Noctalia shell with the same Assuan
+// commands a pinentry client would.
+
+#include "prompt_client/prompt_client.h"
+#include "security/prompt/assuan_session.h"
+#include "security/prompt/prompt_socket_path.h"
+
+#include <cerrno>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unistd.h>
+
+namespace {
+
+  class LineReader {
+  public:
+    explicit LineReader(int fd) : m_fd(fd) {}
+    ~LineReader() { secret_prompt::wipe(m_buffer); }
+
+    bool next(std::string& line) {
+      while (true) {
+        if (const auto newline = m_buffer.find('\n'); newline != std::string::npos) {
+          line.assign(m_buffer, 0, newline);
+          ::explicit_bzero(m_buffer.data(), newline + 1);
+          m_buffer.erase(0, newline + 1);
+          return true;
+        }
+        char buf[1024];
+        const auto n = ::read(m_fd, buf, sizeof(buf));
+        if (n < 0 && errno == EINTR) {
+          continue;
+        }
+        if (n <= 0) {
+          return false;
+        }
+        m_buffer.append(buf, static_cast<std::size_t>(n));
+        ::explicit_bzero(buf, sizeof(buf));
+      }
+    }
+
+  private:
+    int m_fd;
+    std::string m_buffer;
+  };
+
+  bool sendLine(int fd, const std::string& line) {
+    const std::string out = line + "\n";
+    std::size_t sent = 0;
+    while (sent < out.size()) {
+      const auto n = ::write(fd, out.data() + sent, out.size() - sent);
+      if (n < 0) {
+        if (errno == EINTR) {
+          continue;
+        }
+        return false;
+      }
+      sent += static_cast<std::size_t>(n);
+    }
+    return true;
+  }
+
+  // Reads one reply: data lines are collected into `data`. True on OK, false on ERR or EOF.
+  bool readReply(LineReader& reader, std::string& data) {
+    std::string line;
+    while (reader.next(line)) {
+      if (line.starts_with("D ")) {
+        std::string decoded = secret_prompt::percentDecode(std::string_view(line).substr(2));
+        data += decoded;
+        secret_prompt::wipe(decoded);
+        secret_prompt::wipe(line);
+        continue;
+      }
+      if (line == "OK" || line.starts_with("OK ")) {
+        return true;
+      }
+      if (line.starts_with("ERR")) {
+        return false;
+      }
+      // "S" status and "#" comment lines carry nothing for us.
+    }
+    return false;
+  }
+
+} // namespace
+
+int main(int argc, char** argv) {
+  std::signal(SIGPIPE, SIG_IGN);
+  const std::string prompt = argc > 1 ? argv[1] : "";
+
+  const int sock = secret_prompt::connectPromptSocket(secret_prompt::kAskpassSocketKind);
+  if (sock < 0) {
+    if (const char* program = std::getenv("NOCTALIA_ASKPASS_FALLBACK"); program != nullptr && program[0] != '\0') {
+      argv[0] = const_cast<char*>(program);
+      ::execv(program, argv);
+      std::fprintf(stderr, "noctalia-askpass: cannot run %s: %s\n", program, std::strerror(errno));
+      return 1;
+    }
+    std::fprintf(stderr, "noctalia-askpass: Noctalia is not reachable\n");
+    return 1;
+  }
+
+  LineReader reader(sock);
+  std::string data;
+  if (!readReply(reader, data)) {
+    std::fprintf(stderr, "noctalia-askpass: unexpected greeting\n");
+    return 1;
+  }
+
+  const secret_prompt::AskpassPlan plan = secret_prompt::planAskpass(prompt, std::getenv("SSH_ASKPASS_PROMPT"));
+  bool ok = true;
+  for (const auto& command : plan.commands) {
+    data.clear();
+    if (!sendLine(sock, command)) {
+      return 1;
+    }
+    ok = readReply(reader, data);
+    if (!ok) {
+      break;
+    }
+  }
+  sendLine(sock, "BYE");
+  ::close(sock);
+
+  if (!ok) {
+    secret_prompt::wipe(data);
+    return 1;
+  }
+  if (plan.mode == secret_prompt::AskpassMode::Secret) {
+    data += '\n';
+    std::fwrite(data.data(), 1, data.size(), stdout);
+    std::fflush(stdout);
+    secret_prompt::wipe(data);
+  }
+  return 0;
+}
diff --git c/src/prompt_client/pinentry_main.cpp w/src/prompt_client/pinentry_main.cpp
new file mode 100644
index 000000000..7013c6113
--- /dev/null
+++ w/src/prompt_client/pinentry_main.cpp
@@ -0,0 +1,92 @@
+// noctalia-pinentry: gpg-agent's pinentry-program. Relays the Assuan conversation between the
+// agent (stdin/stdout) and the Noctalia shell, which draws the prompt. Without a reachable shell
+// (TTY, SSH session, Noctalia not running) it execs $NOCTALIA_PINENTRY_FALLBACK with the same
+// arguments, e.g. pinentry-curses.
+
+#include "prompt_client/prompt_client.h"
+#include "security/prompt/prompt_socket_path.h"
+
+#include <cerrno>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace {
+
+  bool writeAll(int fd, const char* data, std::size_t size) {
+    while (size > 0) {
+      const auto n = ::write(fd, data, size);
+      if (n < 0) {
+        if (errno == EINTR) {
+          continue;
+        }
+        return false;
+      }
+      data += n;
+      size -= static_cast<std::size_t>(n);
+    }
+    return true;
+  }
+
+  [[noreturn]] void fallback(char** argv) {
+    const char* program = std::getenv("NOCTALIA_PINENTRY_FALLBACK");
+    if (program != nullptr && program[0] != '\0') {
+      argv[0] = const_cast<char*>(program);
+      ::execv(program, argv);
+      std::fprintf(stderr, "noctalia-pinentry: cannot run %s: %s\n", program, std::strerror(errno));
+    } else {
+      std::fprintf(stderr, "noctalia-pinentry: Noctalia is not reachable and no fallback is set\n");
+    }
+    std::_Exit(1);
+  }
+
+} // namespace
+
+int main(int /*argc*/, char** argv) {
+  std::signal(SIGPIPE, SIG_IGN);
+
+  const int sock = secret_prompt::connectPromptSocket(secret_prompt::kPinentrySocketKind);
+  if (sock < 0) {
+    fallback(argv);
+  }
+
+  pollfd fds[2] = {
+      {.fd = STDIN_FILENO, .events = POLLIN, .revents = 0},
+      {.fd = sock, .events = POLLIN, .revents = 0},
+  };
+  char buf[4096];
+  while (true) {
+    if (::poll(fds, 2, -1) < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      return 1;
+    }
+    if (fds[1].revents != 0) {
+      const auto n = ::read(sock, buf, sizeof(buf));
+      if (n <= 0) {
+        // The shell answered BYE or went away.
+        return n == 0 ? 0 : 1;
+      }
+      if (!writeAll(STDOUT_FILENO, buf, static_cast<std::size_t>(n))) {
+        return 1;
+      }
+    }
+    if (fds[0].fd >= 0 && fds[0].revents != 0) {
+      const auto n = ::read(STDIN_FILENO, buf, sizeof(buf));
+      if (n > 0) {
+        if (!writeAll(sock, buf, static_cast<std::size_t>(n))) {
+          return 1;
+        }
+      } else if (n == 0 || errno != EINTR) {
+        // No more requests; keep reading until the shell answers what is already queued.
+        ::shutdown(sock, SHUT_WR);
+        fds[0].fd = -1;
+      }
+    }
+  }
+}
diff --git c/src/prompt_client/prompt_client.cpp w/src/prompt_client/prompt_client.cpp
new file mode 100644
index 000000000..473a6defd
--- /dev/null
+++ w/src/prompt_client/prompt_client.cpp
@@ -0,0 +1,98 @@
+#include "prompt_client/prompt_client.h"
+
+#include "security/prompt/assuan_session.h"
+#include "security/prompt/prompt_socket_path.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <glob.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace secret_prompt {
+
+  namespace {
+
+    int connectPath(const std::string& path) {
+      sockaddr_un addr{};
+      addr.sun_family = AF_UNIX;
+      if (path.size() >= sizeof(addr.sun_path)) {
+        return -1;
+      }
+      std::memcpy(addr.sun_path, path.c_str(), path.size() + 1);
+      const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+      if (fd < 0) {
+        return -1;
+      }
+      if (::connect(fd, reinterpret_cast<const sockaddr*>(&addr), sizeof(addr)) < 0) {
+        ::close(fd);
+        return -1;
+      }
+      return fd;
+    }
+
+    std::string lowercase(std::string_view text) {
+      std::string out(text);
+      std::ranges::transform(out, out.begin(), [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+      return out;
+    }
+
+  } // namespace
+
+  int connectPromptSocket(std::string_view kind) {
+    if (const std::string display = waylandDisplayName(); !display.empty()) {
+      return connectPath(promptSocketPath(kind, display));
+    }
+    const std::string pattern = promptSocketPath(kind, "*");
+    glob_t matches{};
+    int fd = -1;
+    if (::glob(pattern.c_str(), 0, nullptr, &matches) == 0 && matches.gl_pathc == 1) {
+      fd = connectPath(matches.gl_pathv[0]);
+    }
+    ::globfree(&matches);
+    return fd;
+  }
+
+  bool askpassWantsVisibleInput(std::string_view prompt) {
+    const std::string lower = lowercase(prompt);
+    return lower.starts_with("username") || lower.contains("user name") || lower.contains("(yes/no");
+  }
+
+  AskpassPlan planAskpass(std::string_view prompt, const char* promptEnv) {
+    AskpassPlan plan;
+    const std::string_view mode = promptEnv != nullptr ? promptEnv : "";
+    if (mode == "confirm") {
+      plan.mode = AskpassMode::Confirm;
+    } else if (mode == "none") {
+      plan.mode = AskpassMode::Info;
+    }
+
+    if (plan.mode == AskpassMode::Secret && askpassWantsVisibleInput(prompt)) {
+      plan.commands.emplace_back("OPTION noctalia-visible-input");
+    }
+    if (plan.mode == AskpassMode::Info) {
+      plan.commands.emplace_back("OPTION noctalia-no-buttons");
+    }
+    // ssh prompts end with ": " or a newline; the panel has its own spacing.
+    std::string_view text = prompt;
+    while (!text.empty() && (text.back() == ' ' || text.back() == '\n')) {
+      text.remove_suffix(1);
+    }
+    plan.commands.push_back("SETDESC " + percentEncode(text));
+    switch (plan.mode) {
+    case AskpassMode::Secret:
+      plan.commands.emplace_back("GETPIN");
+      break;
+    case AskpassMode::Confirm:
+      plan.commands.emplace_back("CONFIRM");
+      break;
+    case AskpassMode::Info:
+      plan.commands.emplace_back("MESSAGE");
+      break;
+    }
+    return plan;
+  }
+
+} // namespace secret_prompt
diff --git c/src/prompt_client/prompt_client.h w/src/prompt_client/prompt_client.h
new file mode 100644
index 000000000..85c9e3c33
--- /dev/null
+++ w/src/prompt_client/prompt_client.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace secret_prompt {
+
+  // Connects to the shell's pinentry/askpass socket for this session. Without WAYLAND_DISPLAY
+  // (gpg-agent started before the session exported it), falls back to the only socket of that
+  // kind in the runtime dir. Returns -1 when the shell is not reachable.
+  [[nodiscard]] int connectPromptSocket(std::string_view kind);
+
+  enum class AskpassMode {
+    Secret,  // answer goes to stdout
+    Confirm, // SSH_ASKPASS_PROMPT=confirm: exit status only
+    Info,    // SSH_ASKPASS_PROMPT=none: shown until ssh kills us
+  };
+
+  struct AskpassPlan {
+    AskpassMode mode = AskpassMode::Secret;
+    // Assuan commands, the last one being GETPIN, CONFIRM or MESSAGE.
+    std::vector<std::string> commands;
+  };
+
+  // `promptEnv` is SSH_ASKPASS_PROMPT (may be null).
+  [[nodiscard]] AskpassPlan planAskpass(std::string_view prompt, const char* promptEnv);
+  // Prompts that ask for a name or a yes/no answer rather than a secret.
+  [[nodiscard]] bool askpassWantsVisibleInput(std::string_view prompt);
+
+} // namespace secret_prompt
diff --git c/src/security/prompt/assuan_session.cpp w/src/security/prompt/assuan_session.cpp
new file mode 100644
index 000000000..a666fbd9d
--- /dev/null
+++ w/src/security/prompt/assuan_session.cpp
@@ -0,0 +1,335 @@
+#include "security/prompt/assuan_session.h"
+
+#include <charconv>
+#include <cstring>
+#include <format>
+#include <string>
+#include <unistd.h>
+
+#ifndef NOCTALIA_VERSION
+#define NOCTALIA_VERSION "unknown"
+#endif
+
+namespace secret_prompt {
+
+  namespace {
+
+    int hexValue(char ch) {
+      if (ch >= '0' && ch <= '9') {
+        return ch - '0';
+      }
+      if (ch >= 'a' && ch <= 'f') {
+        return ch - 'a' + 10;
+      }
+      if (ch >= 'A' && ch <= 'F') {
+        return ch - 'A' + 10;
+      }
+      return -1;
+    }
+
+    // Splits "COMMAND args" at the first space.
+    void splitCommand(std::string_view line, std::string_view& command, std::string_view& args) {
+      const auto space = line.find(' ');
+      if (space == std::string_view::npos) {
+        command = line;
+        args = {};
+        return;
+      }
+      command = line.substr(0, space);
+      args = line.substr(space + 1);
+      while (!args.empty() && args.front() == ' ') {
+        args.remove_prefix(1);
+      }
+    }
+
+    void ok(std::string& out) { out += "OK\n"; }
+
+    void err(std::string& out, unsigned code, std::string_view text) {
+      out += std::format("ERR {} {} <Pinentry>\n", code, text);
+    }
+
+    // "D " lines, never splitting a %XX escape across lines.
+    void appendData(std::string& out, std::string_view encoded) {
+      constexpr std::size_t kChunk = kAssuanLineMax - 4; // "D " + payload + "\n"
+      std::size_t pos = 0;
+      while (pos < encoded.size()) {
+        std::size_t len = std::min(kChunk, encoded.size() - pos);
+        if (pos + len < encoded.size()) {
+          for (std::size_t back = 1; back <= 2 && back <= len; ++back) {
+            if (encoded[pos + len - back] == '%') {
+              len -= back;
+              break;
+            }
+          }
+        }
+        out += "D ";
+        out.append(encoded.substr(pos, len));
+        out += '\n';
+        pos += len;
+      }
+    }
+
+  } // namespace
+
+  std::string percentDecode(std::string_view text) {
+    std::string out;
+    out.reserve(text.size());
+    for (std::size_t i = 0; i < text.size(); ++i) {
+      if (text[i] == '%' && i + 2 < text.size()) {
+        const int hi = hexValue(text[i + 1]);
+        const int lo = hexValue(text[i + 2]);
+        if (hi >= 0 && lo >= 0) {
+          out.push_back(static_cast<char>((hi << 4) | lo));
+          i += 2;
+          continue;
+        }
+      }
+      out.push_back(text[i]);
+    }
+    return out;
+  }
+
+  std::string percentEncode(std::string_view text) {
+    std::string out;
+    out.reserve(text.size());
+    for (const char ch : text) {
+      const auto byte = static_cast<unsigned char>(ch);
+      if (ch == '%' || byte < 0x20) {
+        out += std::format("%{:02X}", byte);
+      } else {
+        out.push_back(ch);
+      }
+    }
+    return out;
+  }
+
+  std::string stripMnemonic(std::string_view label) {
+    std::string out;
+    out.reserve(label.size());
+    for (std::size_t i = 0; i < label.size(); ++i) {
+      if (label[i] == '_') {
+        if (i + 1 < label.size() && label[i + 1] == '_') {
+          out.push_back('_');
+          ++i;
+        }
+        continue;
+      }
+      out.push_back(label[i]);
+    }
+    return out;
+  }
+
+  void wipe(std::string& text) noexcept {
+    if (!text.empty()) {
+      ::explicit_bzero(text.data(), text.size());
+    }
+    text.clear();
+  }
+
+  AssuanSession::AssuanSession(PromptOrigin origin) : m_origin(origin) { resetRequest(); }
+
+  AssuanSession::~AssuanSession() = default;
+
+  std::string AssuanSession::greeting() { return "OK Pleased to meet you\n"; }
+
+  void AssuanSession::resetRequest() {
+    m_request = PromptRequest{};
+    m_request.origin = m_origin;
+    m_waiting = false;
+  }
+
+  void AssuanSession::beginPrompt(PromptKind kind) {
+    m_request.kind = kind;
+    m_waiting = true;
+  }
+
+  void AssuanSession::finishPrompt() {
+    m_waiting = false;
+    // pinentry shows an error once: the next GETPIN starts clean unless SETERROR comes again.
+    m_request.error.clear();
+    m_request.oneButton = false;
+  }
+
+  AssuanSession::Action AssuanSession::feedLine(std::string_view line, std::string& out) {
+    if (!line.empty() && line.back() == '\r') {
+      line.remove_suffix(1);
+    }
+    if (line.empty() || line.front() == '#') {
+      return Action::None;
+    }
+    if (m_waiting) {
+      // The client must wait for the answer; anything else is a protocol violation.
+      return Action::None;
+    }
+
+    std::string_view command;
+    std::string_view args;
+    splitCommand(line, command, args);
+
+    auto setField = [&](std::string& field) {
+      field = percentDecode(args);
+      ok(out);
+      return Action::None;
+    };
+
+    if (command == "BYE") {
+      out += "OK closing connection\n";
+      return Action::Close;
+    }
+    if (command == "RESET") {
+      resetRequest();
+      ok(out);
+      return Action::None;
+    }
+    if (command == "NOP"
+        || command == "CLEARPASSPHRASE"
+        || command == "SETQUALITYBAR"
+        || command == "SETQUALITYBAR_TT"
+        || command == "SETGENPIN"
+        || command == "SETGENPIN_TT"
+        || command == "SETREPEATOK"
+        || command == "SETCONSTRAINTS") {
+      ok(out);
+      return Action::None;
+    }
+    if (command == "OPTION") {
+      // Extensions only count on the askpass socket: a gpg secret is always masked.
+      if (m_origin == PromptOrigin::Ssh) {
+        if (args == "noctalia-visible-input") {
+          m_request.visibleInput = true;
+        } else if (args == "noctalia-no-buttons") {
+          m_request.noButtons = true;
+        }
+      }
+      ok(out);
+      return Action::None;
+    }
+    if (command == "SETDESC") {
+      return setField(m_request.description);
+    }
+    if (command == "SETPROMPT") {
+      return setField(m_request.prompt);
+    }
+    if (command == "SETTITLE") {
+      return setField(m_request.title);
+    }
+    if (command == "SETERROR") {
+      return setField(m_request.error);
+    }
+    if (command == "SETOK") {
+      m_request.okLabel = stripMnemonic(percentDecode(args));
+      ok(out);
+      return Action::None;
+    }
+    if (command == "SETCANCEL") {
+      m_request.cancelLabel = stripMnemonic(percentDecode(args));
+      ok(out);
+      return Action::None;
+    }
+    if (command == "SETNOTOK") {
+      m_request.notOkLabel = stripMnemonic(percentDecode(args));
+      ok(out);
+      return Action::None;
+    }
+    if (command == "SETKEYINFO") {
+      return setField(m_request.keyInfo);
+    }
+    if (command == "SETREPEAT") {
+      m_request.wantsRepeat = true;
+      return setField(m_request.repeatPrompt);
+    }
+    if (command == "SETREPEATERROR") {
+      return setField(m_request.repeatError);
+    }
+    if (command == "SETTIMEOUT") {
+      int seconds = 0;
+      const auto [ptr, ec] = std::from_chars(args.data(), args.data() + args.size(), seconds);
+      if (ec != std::errc{} || seconds < 0) {
+        err(out, kErrSyntax, "Invalid value");
+        return Action::None;
+      }
+      m_request.timeoutSeconds = seconds;
+      ok(out);
+      return Action::None;
+    }
+    if (command == "GETINFO") {
+      if (args == "flavor") {
+        appendData(out, "noctalia");
+      } else if (args == "version") {
+        appendData(out, NOCTALIA_VERSION);
+      } else if (args == "pid") {
+        appendData(out, std::to_string(::getpid()));
+      } else {
+        err(out, kErrSyntax, "Unknown info");
+        return Action::None;
+      }
+      ok(out);
+      return Action::None;
+    }
+    if (command == "GETPIN") {
+      beginPrompt(PromptKind::Pin);
+      return Action::Prompt;
+    }
+    if (command == "CONFIRM") {
+      m_request.oneButton = args == "--one-button";
+      beginPrompt(PromptKind::Confirm);
+      return Action::Prompt;
+    }
+    if (command == "MESSAGE") {
+      beginPrompt(PromptKind::Message);
+      return Action::Prompt;
+    }
+
+    err(out, kErrUnknownCommand, "Unknown command");
+    return Action::None;
+  }
+
+  void AssuanSession::answerPin(std::string& pin, std::string& out) {
+    if (!m_waiting || m_request.kind != PromptKind::Pin) {
+      wipe(pin);
+      return;
+    }
+    if (m_request.wantsRepeat) {
+      out += "S PIN_REPEATED\n";
+    }
+    std::string encoded = percentEncode(pin);
+    appendData(out, encoded);
+    wipe(encoded);
+    wipe(pin);
+    ok(out);
+    finishPrompt();
+  }
+
+  void AssuanSession::answerConfirm(bool confirmed, std::string& out) {
+    if (!m_waiting) {
+      return;
+    }
+    if (m_request.kind == PromptKind::Message || confirmed) {
+      ok(out);
+    } else {
+      err(out, kErrNotConfirmed, "Not confirmed");
+    }
+    finishPrompt();
+  }
+
+  void AssuanSession::answerCancel(std::string& out) {
+    if (!m_waiting) {
+      return;
+    }
+    if (m_request.kind == PromptKind::Message) {
+      ok(out);
+    } else {
+      err(out, kErrCanceled, "Operation cancelled");
+    }
+    finishPrompt();
+  }
+
+  void AssuanSession::answerTimeout(std::string& out) {
+    if (!m_waiting) {
+      return;
+    }
+    err(out, kErrTimeout, "Timeout");
+    finishPrompt();
+  }
+
+} // namespace secret_prompt
diff --git c/src/security/prompt/assuan_session.h w/src/security/prompt/assuan_session.h
new file mode 100644
index 000000000..92998ae10
--- /dev/null
+++ w/src/security/prompt/assuan_session.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <string>
+#include <string_view>
+
+namespace secret_prompt {
+
+  // Who connected: the gpg-agent (through noctalia-pinentry) or ssh/git (through noctalia-askpass).
+  // Decided by the socket the client reached, never by anything the client sends.
+  enum class PromptOrigin {
+    Gpg,
+    Ssh,
+  };
+
+  enum class PromptKind {
+    Pin,     // GETPIN: a secret (or, for askpass, a visible answer) goes back to the client
+    Confirm, // CONFIRM: OK / not OK / cancel
+    Message, // MESSAGE: informational, dismissed with OK
+  };
+
+  struct PromptRequest {
+    PromptKind kind = PromptKind::Pin;
+    PromptOrigin origin = PromptOrigin::Gpg;
+    std::string title;
+    std::string description;
+    std::string prompt;
+    std::string error;
+    std::string okLabel;
+    std::string cancelLabel;
+    std::string notOkLabel;
+    std::string keyInfo;
+    // SETREPEAT: ask the secret twice; the panel checks the match before answering.
+    bool wantsRepeat = false;
+    std::string repeatPrompt;
+    std::string repeatError;
+    // CONFIRM --one-button: a single OK, no cancel.
+    bool oneButton = false;
+    // Extensions sent by noctalia-askpass.
+    bool visibleInput = false;
+    bool noButtons = false;
+    int timeoutSeconds = 0;
+  };
+
+  // gpg-error codes with GPG_ERR_SOURCE_PINENTRY (5 << 24), as real pinentries report them.
+  inline constexpr unsigned kErrCanceled = (5U << 24) | 99U;
+  inline constexpr unsigned kErrNotConfirmed = (5U << 24) | 114U;
+  inline constexpr unsigned kErrTimeout = (5U << 24) | 62U;
+  inline constexpr unsigned kErrUnknownCommand = (5U << 24) | 275U;
+  inline constexpr unsigned kErrSyntax = (5U << 24) | 276U;
+
+  // Assuan line limit (including the trailing newline).
+  inline constexpr std::size_t kAssuanLineMax = 1000;
+
+  // Server half of the pinentry Assuan protocol, without any I/O: lines go in, replies are
+  // appended to an output string. GETPIN/CONFIRM/MESSAGE leave the session waiting until one of
+  // the answer*() calls settles it.
+  class AssuanSession {
+  public:
+    enum class Action {
+      None,   // reply (if any) is in the output, keep reading
+      Prompt, // a request is waiting for the user
+      Close,  // BYE or a fatal error: flush the output and close
+    };
+
+    explicit AssuanSession(PromptOrigin origin);
+    ~AssuanSession();
+
+    AssuanSession(const AssuanSession&) = delete;
+    AssuanSession& operator=(const AssuanSession&) = delete;
+
+    [[nodiscard]] static std::string greeting();
+
+    // One line without its trailing '\n'.
+    Action feedLine(std::string_view line, std::string& out);
+
+    [[nodiscard]] bool waiting() const noexcept { return m_waiting; }
+    [[nodiscard]] const PromptRequest& request() const noexcept { return m_request; }
+
+    // Answers the waiting GETPIN. The secret is wiped from `pin` and from internal buffers.
+    void answerPin(std::string& pin, std::string& out);
+    // Answers the waiting CONFIRM (or dismisses MESSAGE, where `confirmed` is ignored).
+    void answerConfirm(bool confirmed, std::string& out);
+    void answerCancel(std::string& out);
+    void answerTimeout(std::string& out);
+
+  private:
+    void resetRequest();
+    void beginPrompt(PromptKind kind);
+    void finishPrompt();
+
+    PromptOrigin m_origin;
+    PromptRequest m_request;
+    bool m_waiting = false;
+  };
+
+  // Percent-decoding of SET* arguments ("%0A" → '\n').
+  [[nodiscard]] std::string percentDecode(std::string_view text);
+  // Percent-encoding for data lines and command arguments: '%', CR, LF and other controls.
+  [[nodiscard]] std::string percentEncode(std::string_view text);
+  // pinentry labels mark accelerators with '_' ("_OK"); "__" is a literal underscore.
+  [[nodiscard]] std::string stripMnemonic(std::string_view label);
+  // Overwrites the bytes of a string before it is released.
+  void wipe(std::string& text) noexcept;
+
+} // namespace secret_prompt
diff --git c/src/security/prompt/prompt_socket_path.h w/src/security/prompt/prompt_socket_path.h
