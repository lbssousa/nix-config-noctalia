diff --git c/tests/askpass_plan_test.cpp w/tests/askpass_plan_test.cpp
new file mode 100644
index 000000000..57c2f041f
--- /dev/null
+++ w/tests/askpass_plan_test.cpp
@@ -0,0 +1,54 @@
+#include "prompt_client/prompt_client.h"
+#include "tests/test_check.h"
+
+#include <string>
+
+namespace {
+
+  using secret_prompt::AskpassMode;
+  using secret_prompt::planAskpass;
+
+  void testSecret() {
+    const auto plan = planAskpass("Enter passphrase for key '/home/u/.ssh/id_ed25519': ", nullptr);
+    TEST_CHECK(plan.mode == AskpassMode::Secret);
+    TEST_CHECK(plan.commands.size() == 2);
+    TEST_CHECK(plan.commands[0] == "SETDESC Enter passphrase for key '/home/u/.ssh/id_ed25519':");
+    TEST_CHECK(plan.commands[1] == "GETPIN");
+  }
+
+  void testVisible() {
+    const auto user = planAskpass("Username for 'https://github.com': ", "");
+    TEST_CHECK(user.commands.front() == "OPTION noctalia-visible-input");
+    TEST_CHECK(user.commands.back() == "GETPIN");
+
+    const auto host = planAskpass(
+        "The authenticity of host 'h' can't be established.\nAre you sure you want to continue connecting "
+        "(yes/no/[fingerprint])? ",
+        nullptr
+    );
+    TEST_CHECK(host.commands.front() == "OPTION noctalia-visible-input");
+    TEST_CHECK(host.commands[1].find("%0AAre you sure") != std::string::npos);
+
+    TEST_CHECK(!secret_prompt::askpassWantsVisibleInput("Password for 'https://u@github.com': "));
+  }
+
+  void testConfirmAndInfo() {
+    const auto confirm = planAskpass("Allow use of key?", "confirm");
+    TEST_CHECK(confirm.mode == AskpassMode::Confirm);
+    TEST_CHECK(confirm.commands.back() == "CONFIRM");
+
+    const auto info = planAskpass("Confirm user presence for key ED25519-SK SHA256:x\n", "none");
+    TEST_CHECK(info.mode == AskpassMode::Info);
+    TEST_CHECK(info.commands.front() == "OPTION noctalia-no-buttons");
+    TEST_CHECK(info.commands.back() == "MESSAGE");
+    TEST_CHECK(info.commands[1] == "SETDESC Confirm user presence for key ED25519-SK SHA256:x");
+  }
+
+} // namespace
+
+int main() {
+  testSecret();
+  testVisible();
+  testConfirmAndInfo();
+  return 0;
+}
diff --git c/tests/assuan_session_test.cpp w/tests/assuan_session_test.cpp
new file mode 100644
index 000000000..b6f03f72f
--- /dev/null
+++ w/tests/assuan_session_test.cpp
@@ -0,0 +1,170 @@
+#include "security/prompt/assuan_session.h"
+#include "tests/test_check.h"
+
+#include <string>
+#include <string_view>
+
+namespace {
+
+  using secret_prompt::AssuanSession;
+  using secret_prompt::PromptKind;
+  using secret_prompt::PromptOrigin;
+
+  AssuanSession::Action feed(AssuanSession& session, std::string_view line, std::string& out) {
+    out.clear();
+    return session.feedLine(line, out);
+  }
+
+  void testGetPin() {
+    AssuanSession session(PromptOrigin::Gpg);
+    std::string out;
+    TEST_CHECK(AssuanSession::greeting() == "OK Pleased to meet you\n");
+    TEST_CHECK(feed(session, "OPTION ttyname=/dev/pts/1", out) == AssuanSession::Action::None && out == "OK\n");
+    TEST_CHECK(feed(session, "SETDESC Please enter%0Athe passphrase%25", out) == AssuanSession::Action::None);
+    TEST_CHECK(feed(session, "SETPROMPT Passphrase:", out) == AssuanSession::Action::None);
+    TEST_CHECK(feed(session, "SETOK _OK", out) == AssuanSession::Action::None);
+    TEST_CHECK(feed(session, "SETCANCEL _Cancel__x", out) == AssuanSession::Action::None);
+    TEST_CHECK(feed(session, "SETERROR Bad passphrase", out) == AssuanSession::Action::None);
+    TEST_CHECK(feed(session, "GETPIN", out) == AssuanSession::Action::Prompt && out.empty());
+    TEST_CHECK(session.waiting());
+    const auto& request = session.request();
+    TEST_CHECK(request.kind == PromptKind::Pin);
+    TEST_CHECK(request.description == "Please enter\nthe passphrase%");
+    TEST_CHECK(request.prompt == "Passphrase:");
+    TEST_CHECK(request.okLabel == "OK");
+    TEST_CHECK(request.cancelLabel == "Cancel_x");
+    TEST_CHECK(request.error == "Bad passphrase");
+    TEST_CHECK(!request.visibleInput);
+
+    // Lines arriving while waiting are ignored.
+    TEST_CHECK(feed(session, "GETPIN", out) == AssuanSession::Action::None && out.empty());
+
+    std::string pin = "s%e\ncret";
+    out.clear();
+    session.answerPin(pin, out);
+    TEST_CHECK(pin.empty());
+    TEST_CHECK(out == "D s%25e%0Acret\nOK\n");
+    TEST_CHECK(!session.waiting());
+    // The error is shown once.
+    TEST_CHECK(session.request().error.empty());
+    TEST_CHECK(session.request().description == "Please enter\nthe passphrase%");
+
+    TEST_CHECK(feed(session, "BYE", out) == AssuanSession::Action::Close);
+  }
+
+  void testRepeatAndLongPin() {
+    AssuanSession session(PromptOrigin::Gpg);
+    std::string out;
+    feed(session, "SETREPEAT Repeat:", out);
+    feed(session, "SETREPEATERROR does not match", out);
+    TEST_CHECK(feed(session, "GETPIN", out) == AssuanSession::Action::Prompt);
+    TEST_CHECK(session.request().wantsRepeat);
+    TEST_CHECK(session.request().repeatPrompt == "Repeat:");
+    TEST_CHECK(session.request().repeatError == "does not match");
+
+    std::string pin(1500, '%');
+    out.clear();
+    session.answerPin(pin, out);
+    TEST_CHECK(out.starts_with("S PIN_REPEATED\nD "));
+    TEST_CHECK(out.ends_with("\nOK\n"));
+    // Every data line fits the Assuan limit and no %XX escape is split.
+    std::size_t pos = out.find("D ");
+    std::size_t decoded = 0;
+    while (pos != std::string::npos && out.compare(pos, 2, "D ") == 0) {
+      const auto end = out.find('\n', pos);
+      TEST_CHECK(end - pos + 1 <= secret_prompt::kAssuanLineMax);
+      const std::string_view payload(out.data() + pos + 2, end - pos - 2);
+      TEST_CHECK(payload.size() % 3 == 0);
+      decoded += secret_prompt::percentDecode(payload).size();
+      pos = end + 1;
+    }
+    TEST_CHECK(decoded == 1500);
+  }
+
+  void testConfirmAndMessage() {
+    AssuanSession session(PromptOrigin::Gpg);
+    std::string out;
+    feed(session, "SETNOTOK _No", out);
+    TEST_CHECK(feed(session, "CONFIRM --one-button", out) == AssuanSession::Action::Prompt);
+    TEST_CHECK(session.request().kind == PromptKind::Confirm);
+    TEST_CHECK(session.request().oneButton);
+    TEST_CHECK(session.request().notOkLabel == "No");
+    out.clear();
+    session.answerConfirm(true, out);
+    TEST_CHECK(out == "OK\n");
+
+    TEST_CHECK(feed(session, "CONFIRM", out) == AssuanSession::Action::Prompt);
+    TEST_CHECK(!session.request().oneButton);
+    out.clear();
+    session.answerConfirm(false, out);
+    TEST_CHECK(out == "ERR 83886194 Not confirmed <Pinentry>\n");
+
+    TEST_CHECK(feed(session, "CONFIRM", out) == AssuanSession::Action::Prompt);
+    out.clear();
+    session.answerCancel(out);
+    TEST_CHECK(out == "ERR 83886179 Operation cancelled <Pinentry>\n");
+
+    TEST_CHECK(feed(session, "MESSAGE", out) == AssuanSession::Action::Prompt);
+    TEST_CHECK(session.request().kind == PromptKind::Message);
+    out.clear();
+    session.answerCancel(out);
+    TEST_CHECK(out == "OK\n");
+  }
+
+  void testTimeoutAndErrors() {
+    AssuanSession session(PromptOrigin::Gpg);
+    std::string out;
+    TEST_CHECK(feed(session, "SETTIMEOUT 30", out) == AssuanSession::Action::None && out == "OK\n");
+    TEST_CHECK(feed(session, "SETTIMEOUT nope", out) == AssuanSession::Action::None && out.starts_with("ERR "));
+    TEST_CHECK(feed(session, "GETPIN", out) == AssuanSession::Action::Prompt);
+    TEST_CHECK(session.request().timeoutSeconds == 30);
+    out.clear();
+    session.answerTimeout(out);
+    TEST_CHECK(out == "ERR 83886142 Timeout <Pinentry>\n");
+
+    TEST_CHECK(feed(session, "FROBNICATE", out) == AssuanSession::Action::None && out.starts_with("ERR "));
+    TEST_CHECK(feed(session, "# comment", out) == AssuanSession::Action::None && out.empty());
+    TEST_CHECK(feed(session, "GETINFO flavor", out) == AssuanSession::Action::None && out == "D noctalia\nOK\n");
+    TEST_CHECK(feed(session, "NOP\r", out) == AssuanSession::Action::None && out == "OK\n");
+    TEST_CHECK(feed(session, "SETDESC x", out) == AssuanSession::Action::None);
+    TEST_CHECK(feed(session, "RESET", out) == AssuanSession::Action::None && out == "OK\n");
+    TEST_CHECK(session.request().description.empty());
+  }
+
+  void testExtensionsOnlyForAskpass() {
+    std::string out;
+    AssuanSession gpg(PromptOrigin::Gpg);
+    feed(gpg, "OPTION noctalia-visible-input", out);
+    feed(gpg, "OPTION noctalia-no-buttons", out);
+    TEST_CHECK(!gpg.request().visibleInput);
+    TEST_CHECK(!gpg.request().noButtons);
+
+    AssuanSession ssh(PromptOrigin::Ssh);
+    feed(ssh, "OPTION noctalia-visible-input", out);
+    feed(ssh, "OPTION noctalia-no-buttons", out);
+    TEST_CHECK(ssh.request().visibleInput);
+    TEST_CHECK(ssh.request().noButtons);
+    TEST_CHECK(ssh.request().origin == PromptOrigin::Ssh);
+  }
+
+  void testHelpers() {
+    TEST_CHECK(secret_prompt::percentDecode("a%2") == "a%2");
+    TEST_CHECK(secret_prompt::percentDecode("%zz%41") == "%zzA");
+    TEST_CHECK(secret_prompt::percentEncode("a\r\n%b") == "a%0D%0A%25b");
+    TEST_CHECK(secret_prompt::stripMnemonic("_Save__As") == "Save_As");
+    std::string text = "secret";
+    secret_prompt::wipe(text);
+    TEST_CHECK(text.empty());
+  }
+
+} // namespace
+
+int main() {
+  testGetPin();
+  testRepeatAndLongPin();
+  testConfirmAndMessage();
+  testTimeoutAndErrors();
+  testExtensionsOnlyForAskpass();
+  testHelpers();
+  return 0;
+}
diff --git c/tests/secret_prompt_service_test.cpp w/tests/secret_prompt_service_test.cpp
new file mode 100644
index 000000000..66f0508a2
--- /dev/null
+++ w/tests/secret_prompt_service_test.cpp
@@ -0,0 +1,179 @@
+#include "security/prompt/secret_prompt_service.h"
+#include "tests/test_check.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <poll.h>
+#include <string>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <vector>
+
+namespace {
+
+  using secret_prompt::PromptKind;
+  using secret_prompt::PromptOrigin;
+
+  void pump(SecretPromptService& service, int rounds = 5) {
+    for (int i = 0; i < rounds; ++i) {
+      std::vector<pollfd> fds;
+      service.addPollFds(fds);
+      const int timeout = service.pollTimeoutMs();
+      ::poll(fds.data(), fds.size(), timeout >= 0 ? std::min(timeout, 20) : 20);
+      service.dispatch(fds, 0);
+    }
+  }
+
+  int connectTo(PromptOrigin origin) {
+    const std::string path = SecretPromptService::socketPath(origin);
+    sockaddr_un addr{};
+    addr.sun_family = AF_UNIX;
+    std::memcpy(addr.sun_path, path.c_str(), path.size() + 1);
+    const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    TEST_CHECK(fd >= 0);
+    TEST_CHECK(::connect(fd, reinterpret_cast<const sockaddr*>(&addr), sizeof(addr)) == 0);
+    return fd;
+  }
+
+  void sendText(int fd, std::string_view text) {
+    TEST_CHECK(::send(fd, text.data(), text.size(), MSG_NOSIGNAL) == static_cast<ssize_t>(text.size()));
+  }
+
+  // Reads whatever the service has sent so far.
+  std::string drain(int fd) {
+    std::string out;
+    char buf[1024];
+    while (true) {
+      pollfd p{.fd = fd, .events = POLLIN, .revents = 0};
+      if (::poll(&p, 1, 20) <= 0) {
+        break;
+      }
+      const auto n = ::recv(fd, buf, sizeof(buf), 0);
+      if (n <= 0) {
+        break;
+      }
+      out.append(buf, static_cast<std::size_t>(n));
+    }
+    return out;
+  }
+
+  void testPinWithHalfClose(SecretPromptService& service) {
+    const int fd = connectTo(PromptOrigin::Gpg);
+    pump(service);
+    TEST_CHECK(drain(fd) == "OK Pleased to meet you\n");
+    // Like `echo ... | noctalia-pinentry`: everything at once, then EOF on the write side.
+    sendText(fd, "SETDESC Unlock%0Akey\nGETPIN\nBYE\n");
+    ::shutdown(fd, SHUT_WR);
+    pump(service);
+    TEST_CHECK(service.hasPendingRequest());
+    const auto request = service.pendingRequest();
+    TEST_CHECK(request.kind == PromptKind::Pin);
+    TEST_CHECK(request.origin == PromptOrigin::Gpg);
+    TEST_CHECK(request.description == "Unlock\nkey");
+    std::string secret = "hunter2";
+    service.submitSecret(secret);
+    TEST_CHECK(secret.empty());
+    pump(service);
+    TEST_CHECK(drain(fd) == "OK\nD hunter2\nOK\nOK closing connection\n");
+    TEST_CHECK(!service.hasPendingRequest());
+    ::close(fd);
+  }
+
+  void testClientVanishes(SecretPromptService& service) {
+    const int fd = connectTo(PromptOrigin::Gpg);
+    sendText(fd, "GETPIN\n");
+    pump(service);
+    TEST_CHECK(service.hasPendingRequest());
+    ::close(fd);
+    pump(service);
+    TEST_CHECK(!service.hasPendingRequest());
+  }
+
+  void testQueueAndCancel(SecretPromptService& service) {
+    const int first = connectTo(PromptOrigin::Gpg);
+    sendText(first, "SETDESC first\nGETPIN\n");
+    pump(service);
+    const int second = connectTo(PromptOrigin::Ssh);
+    sendText(second, "OPTION noctalia-visible-input\nSETDESC second\nGETPIN\n");
+    pump(service);
+    TEST_CHECK(service.pendingRequest().description == "first");
+    const auto firstId = service.pendingId();
+    service.cancel();
+    pump(service);
+    TEST_CHECK(drain(first).ends_with("ERR 83886179 Operation cancelled <Pinentry>\n"));
+    TEST_CHECK(service.hasPendingRequest());
+    TEST_CHECK(service.pendingId() != firstId);
+    const auto request = service.pendingRequest();
+    TEST_CHECK(request.description == "second");
+    TEST_CHECK(request.origin == PromptOrigin::Ssh);
+    TEST_CHECK(request.visibleInput);
+    service.cancelAll();
+    pump(service);
+    TEST_CHECK(!service.hasPendingRequest());
+    TEST_CHECK(drain(second).ends_with("ERR 83886179 Operation cancelled <Pinentry>\n"));
+    ::close(first);
+    ::close(second);
+    pump(service);
+  }
+
+  void testConfirmAndTimeout(SecretPromptService& service) {
+    const int fd = connectTo(PromptOrigin::Gpg);
+    sendText(fd, "CONFIRM\n");
+    pump(service);
+    TEST_CHECK(service.pendingRequest().kind == PromptKind::Confirm);
+    service.confirm(false);
+    pump(service);
+    TEST_CHECK(drain(fd).ends_with("ERR 83886194 Not confirmed <Pinentry>\n"));
+
+    sendText(fd, "SETTIMEOUT 1\nGETPIN\n");
+    pump(service);
+    TEST_CHECK(service.hasPendingRequest());
+    TEST_CHECK(service.pollTimeoutMs() >= 0);
+    const auto start = std::chrono::steady_clock::now();
+    while (service.hasPendingRequest() && std::chrono::steady_clock::now() - start < std::chrono::seconds(3)) {
+      pump(service, 1);
+    }
+    TEST_CHECK(!service.hasPendingRequest());
+    TEST_CHECK(drain(fd).ends_with("ERR 83886142 Timeout <Pinentry>\n"));
+    ::close(fd);
+    pump(service);
+  }
+
+} // namespace
+
+int main() {
+  char pattern[] = "/tmp/noctalia-secret-prompt-XXXXXX";
+  TEST_CHECK(::mkdtemp(pattern) != nullptr);
+  ::setenv("XDG_RUNTIME_DIR", pattern, 1);
+  ::setenv("WAYLAND_DISPLAY", "wayland-test", 1);
+
+  {
+    SecretPromptService service;
+    int notifications = 0;
+    service.setStateCallback([&notifications]() { ++notifications; });
+    service.setEnabled(true, true);
+    TEST_CHECK(service.active());
+    TEST_CHECK(std::filesystem::exists(SecretPromptService::socketPath(PromptOrigin::Gpg)));
+    const auto perms = std::filesystem::status(SecretPromptService::socketPath(PromptOrigin::Ssh)).permissions();
+    TEST_CHECK(
+        (perms & (std::filesystem::perms::group_all | std::filesystem::perms::others_all))
+        == std::filesystem::perms::none
+    );
+
+    testPinWithHalfClose(service);
+    testClientVanishes(service);
+    testQueueAndCancel(service);
+    testConfirmAndTimeout(service);
+    TEST_CHECK(notifications > 0);
+
+    service.setEnabled(false, true);
+    TEST_CHECK(!std::filesystem::exists(SecretPromptService::socketPath(PromptOrigin::Gpg)));
+    TEST_CHECK(std::filesystem::exists(SecretPromptService::socketPath(PromptOrigin::Ssh)));
+  }
+  TEST_CHECK(!std::filesystem::exists(SecretPromptService::socketPath(PromptOrigin::Ssh)));
+  std::filesystem::remove_all(pattern);
+  return 0;
+}
