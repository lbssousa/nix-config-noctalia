diff --git a/src/security/fingerprint_manager.cpp b/src/security/fingerprint_manager.cpp
new file mode 100644
index 000000000..82a25ea77
--- /dev/null
+++ b/src/security/fingerprint_manager.cpp
@@ -0,0 +1,593 @@
+#include "security/fingerprint_manager.h"
+
+#include "core/deferred_call.h"
+#include "core/log.h"
+#include "dbus/system_bus.h"
+#include "i18n/i18n.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <sdbus-c++/Error.h>
+#include <sdbus-c++/IConnection.h>
+#include <sdbus-c++/IProxy.h>
+#include <sdbus-c++/Types.h>
+#include <string>
+#include <utility>
+
+namespace {
+  constexpr Logger kLog("fingerprint-manager");
+
+  const sdbus::ServiceName kFprintBusName{"net.reactivated.Fprint"};
+  const sdbus::ObjectPath kManagerPath{"/net/reactivated/Fprint/Manager"};
+  constexpr auto kManagerInterface = "net.reactivated.Fprint.Manager";
+  constexpr auto kDeviceInterface = "net.reactivated.Fprint.Device";
+
+  const sdbus::ServiceName kDbusBusName{"org.freedesktop.DBus"};
+  const sdbus::ObjectPath kDbusPath{"/org/freedesktop/DBus"};
+  constexpr auto kDbusInterface = "org.freedesktop.DBus";
+
+  // Claim and EnrollStart may wait on a polkit prompt; the default 25 s D-Bus timeout is too short.
+  constexpr auto kInteractiveTimeout = std::chrono::minutes(2);
+  constexpr auto kVerifyTimeout = std::chrono::seconds(30);
+
+  std::string errorMessage(const sdbus::Error& error) {
+    static const std::map<std::string, std::string> kErrors = {
+        {"net.reactivated.Fprint.Error.PermissionDenied", "settings.fingerprint.error.permission-denied"},
+        {"net.reactivated.Fprint.Error.AlreadyInUse", "settings.fingerprint.error.in-use"},
+        {"net.reactivated.Fprint.Error.NoEnrolledPrints", "settings.fingerprint.error.no-prints"},
+        {"net.reactivated.Fprint.Error.PrintsNotDeleted", "settings.fingerprint.error.not-deleted"},
+        {"net.reactivated.Fprint.Error.NoSuchDevice", "settings.fingerprint.error.no-device"},
+    };
+    const auto it = kErrors.find(std::string(error.getName()));
+    if (it != kErrors.end()) {
+      return i18n::tr(it->second);
+    }
+    return i18n::tr("settings.fingerprint.error.generic", "message", error.getMessage());
+  }
+
+  // fprintd scan feedback shared by enroll and verify ("enroll-retry-scan", "verify-retry-scan").
+  std::optional<std::string> retryMessage(std::string_view suffix) {
+    if (suffix == "retry-scan") {
+      return i18n::tr("settings.fingerprint.status.retry-scan");
+    }
+    if (suffix == "swipe-too-short") {
+      return i18n::tr("settings.fingerprint.status.swipe-too-short");
+    }
+    if (suffix == "finger-not-centered") {
+      return i18n::tr("settings.fingerprint.status.finger-not-centered");
+    }
+    if (suffix == "remove-and-retry") {
+      return i18n::tr("settings.fingerprint.status.remove-and-retry");
+    }
+    return std::nullopt;
+  }
+
+  std::string touchPrompt(const std::vector<FingerprintDevice>& devices, const std::string& path) {
+    const auto it = std::ranges::find(devices, path, &FingerprintDevice::path);
+    if (it != devices.end() && it->scanType == "swipe") {
+      return i18n::tr("settings.fingerprint.status.swipe");
+    }
+    return i18n::tr("settings.fingerprint.status.touch");
+  }
+} // namespace
+
+FingerprintManager::FingerprintManager(SystemBus& bus) : m_bus(bus) {}
+
+FingerprintManager::~FingerprintManager() {
+  m_alive.reset();
+  m_verifyTimeout.stop();
+  if (m_device != nullptr && m_claimed) {
+    try {
+      m_device->callMethod("Release").onInterface(kDeviceInterface);
+    } catch (const sdbus::Error&) {
+    }
+  }
+}
+
+void FingerprintManager::setChangedCallback(ChangedCallback callback) { m_onChanged = std::move(callback); }
+
+bool FingerprintManager::serviceAvailable() {
+  if (m_serviceAvailable.has_value()) {
+    return *m_serviceAvailable;
+  }
+  bool available = m_bus.nameHasOwner(std::string(kFprintBusName));
+  if (!available) {
+    try {
+      auto dbus = sdbus::createProxy(m_bus.connection(), kDbusBusName, kDbusPath);
+      std::vector<std::string> names;
+      dbus->callMethod("ListActivatableNames").onInterface(kDbusInterface).storeResultsTo(names);
+      available = std::ranges::contains(names, std::string(kFprintBusName));
+    } catch (const sdbus::Error& e) {
+      kLog.debug("could not list activatable names: {}", e.what());
+    }
+  }
+  m_serviceAvailable = available;
+  return available;
+}
+
+void FingerprintManager::refresh() {
+  if (m_loading || busy()) {
+    return;
+  }
+  m_loading = true;
+  try {
+    if (m_manager == nullptr) {
+      m_manager = sdbus::createProxy(m_bus.connection(), kFprintBusName, kManagerPath);
+    }
+  } catch (const sdbus::Error& e) {
+    kLog.warn("could not create fprintd manager proxy: {}", e.what());
+    m_loading = false;
+    m_loaded = true;
+    notifyChanged();
+    return;
+  }
+
+  // GetDevices D-Bus-activates fprintd on first use, which can take a moment: keep it async.
+  m_manager->callMethodAsync("GetDevices")
+      .onInterface(kManagerInterface)
+      .uponReplyInvoke([this, alive = std::weak_ptr<void>(m_alive)](
+                           std::optional<sdbus::Error> e, std::vector<sdbus::ObjectPath> paths
+                       ) {
+        if (alive.expired()) {
+          return;
+        }
+        m_loading = false;
+        m_loaded = true;
+        if (e.has_value()) {
+          kLog.info("could not list fingerprint readers: {}", e->what());
+          paths.clear();
+        }
+
+        std::vector<FingerprintDevice> devices;
+        for (const auto& path : paths) {
+          FingerprintDevice device{.path = path, .name = path, .scanType = "press"};
+          try {
+            auto proxy = sdbus::createProxy(m_bus.connection(), kFprintBusName, path);
+            device.name = proxy->getProperty("name").onInterface(kDeviceInterface).get<std::string>();
+            device.scanType = proxy->getProperty("scan-type").onInterface(kDeviceInterface).get<std::string>();
+          } catch (const sdbus::Error& err) {
+            kLog.debug("could not read fingerprint reader properties: {}", err.what());
+          }
+          devices.push_back(std::move(device));
+        }
+        m_devices = std::move(devices);
+
+        if (std::ranges::find(m_devices, m_selectedPath, &FingerprintDevice::path) == m_devices.end()) {
+          m_selectedPath = m_devices.empty() ? std::string{} : m_devices.front().path;
+          dropDeviceProxyLater();
+        }
+        if (m_selectedPath.empty()) {
+          m_enrolled.clear();
+          notifyChanged();
+          return;
+        }
+        // The proxy may be dropped on the next loop iteration; list on a fresh one afterwards.
+        DeferredCall::callLater([this, alive]() {
+          if (!alive.expired()) {
+            loadEnrolled();
+          }
+        });
+      });
+}
+
+void FingerprintManager::selectDevice(const std::string& path) {
+  if (path == m_selectedPath || busy()) {
+    return;
+  }
+  m_selectedPath = path;
+  m_enrolled.clear();
+  clearStatus();
+  dropDeviceProxyLater();
+  DeferredCall::callLater([this, alive = std::weak_ptr<void>(m_alive)]() {
+    if (!alive.expired()) {
+      loadEnrolled();
+    }
+  });
+  notifyChanged();
+}
+
+bool FingerprintManager::ensureDeviceProxy() {
+  if (m_device != nullptr) {
+    return true;
+  }
+  if (m_selectedPath.empty()) {
+    return false;
+  }
+  try {
+    m_device = sdbus::createProxy(m_bus.connection(), kFprintBusName, sdbus::ObjectPath{m_selectedPath});
+  } catch (const sdbus::Error& e) {
+    kLog.warn("could not create fingerprint reader proxy: {}", e.what());
+    return false;
+  }
+  m_device->uponSignal("EnrollStatus").onInterface(kDeviceInterface).call([this](const std::string& result, bool done) {
+    handleEnrollStatus(result, done);
+  });
+  m_device->uponSignal("VerifyStatus").onInterface(kDeviceInterface).call([this](const std::string& result, bool done) {
+    handleVerifyStatus(result, done);
+  });
+  m_device->uponSignal("VerifyFingerSelected").onInterface(kDeviceInterface).call([this](const std::string& finger) {
+    if (m_mode == Mode::Verifying) {
+      m_matchedFinger = finger;
+    }
+  });
+  return true;
+}
+
+void FingerprintManager::dropDeviceProxyLater() {
+  if (m_device == nullptr) {
+    return;
+  }
+  // Never destroy a proxy from inside one of its own reply handlers.
+  DeferredCall::callLater([this, alive = std::weak_ptr<void>(m_alive)]() {
+    if (alive.expired() || busy()) {
+      return;
+    }
+    m_device.reset();
+    m_claimed = false;
+  });
+}
+
+void FingerprintManager::loadEnrolled() {
+  if (!ensureDeviceProxy()) {
+    m_enrolled.clear();
+    notifyChanged();
+    return;
+  }
+  // Empty user name: fprintd uses the caller's user.
+  m_device->callMethodAsync("ListEnrolledFingers")
+      .onInterface(kDeviceInterface)
+      .withArguments(std::string{})
+      .uponReplyInvoke([this, alive = std::weak_ptr<void>(m_alive)](
+                           std::optional<sdbus::Error> e, std::vector<std::string> fingers
+                       ) {
+        if (alive.expired()) {
+          return;
+        }
+        if (e.has_value()) {
+          // NoEnrolledPrints is the normal "nothing enrolled yet" answer.
+          if (e->getName() != sdbus::Error::Name{"net.reactivated.Fprint.Error.NoEnrolledPrints"}) {
+            kLog.info("could not list enrolled fingers: {}", e->what());
+          }
+          fingers.clear();
+        }
+        m_enrolled = std::move(fingers);
+        notifyChanged();
+      });
+}
+
+void FingerprintManager::claimThen(std::function<void()> next) {
+  if (!ensureDeviceProxy()) {
+    setStatus(i18n::tr("settings.fingerprint.error.no-device"), true);
+    finishOperation();
+    return;
+  }
+  if (m_claimed) {
+    next();
+    return;
+  }
+  m_claiming = true;
+  m_device->callMethodAsync("Claim")
+      .onInterface(kDeviceInterface)
+      .withTimeout(kInteractiveTimeout)
+      .withArguments(std::string{})
+      .uponReplyInvoke([this, alive = std::weak_ptr<void>(m_alive),
+                        next = std::move(next)](std::optional<sdbus::Error> e) {
+        if (alive.expired()) {
+          return;
+        }
+        m_claiming = false;
+        if (e.has_value()) {
+          kLog.info("could not claim fingerprint reader: {}", e->what());
+          setStatus(errorMessage(*e), true);
+          finishOperation();
+          return;
+        }
+        m_claimed = true;
+        if (m_mode == Mode::Idle) {
+          // Cancelled while the claim was pending.
+          release();
+          return;
+        }
+        next();
+      });
+}
+
+void FingerprintManager::release() {
+  if (m_device == nullptr || !m_claimed) {
+    return;
+  }
+  m_claimed = false;
+  m_device->callMethodAsync("Release").onInterface(kDeviceInterface).uponReplyInvoke([](std::optional<sdbus::Error> e) {
+    if (e.has_value()) {
+      kLog.debug("could not release fingerprint reader: {}", e->what());
+    }
+  });
+}
+
+void FingerprintManager::finishOperation() {
+  m_verifyTimeout.stop();
+  m_mode = Mode::Idle;
+  release();
+  notifyChanged();
+}
+
+void FingerprintManager::deleteFinger(const std::string& finger) {
+  if (busy()) {
+    return;
+  }
+  clearStatus();
+  // Claim is required by DeleteEnrolledFinger; borrow the Verifying mode so cancel() and the
+  // claim callback treat it as a running operation.
+  m_mode = Mode::Verifying;
+  claimThen([this, finger]() {
+    m_device->callMethodAsync("DeleteEnrolledFinger")
+        .onInterface(kDeviceInterface)
+        .withTimeout(kInteractiveTimeout)
+        .withArguments(finger)
+        .uponReplyInvoke([this, alive = std::weak_ptr<void>(m_alive), finger](std::optional<sdbus::Error> e) {
+          if (alive.expired()) {
+            return;
+          }
+          if (e.has_value()) {
+            kLog.info("could not delete fingerprint: {}", e->what());
+            setStatus(errorMessage(*e), true);
+          } else {
+            std::erase(m_enrolled, finger);
+            setStatus(i18n::tr("settings.fingerprint.status.deleted", "finger", fingerLabel(finger)), false);
+          }
+          finishOperation();
+          DeferredCall::callLater([this, alive]() {
+            if (!alive.expired() && !busy()) {
+              loadEnrolled();
+            }
+          });
+        });
+  });
+  notifyChanged();
+}
+
+void FingerprintManager::startEnroll(const std::string& finger) {
+  if (busy()) {
+    return;
+  }
+  m_mode = Mode::Enrolling;
+  m_enrollFinger = finger;
+  m_stagesDone = 0;
+  m_stagesTotal = -1;
+  m_enrollCompleted = false;
+  m_matchedFinger.clear();
+  setStatus(i18n::tr("settings.fingerprint.status.preparing"), false);
+
+  claimThen([this, finger]() {
+    try {
+      m_stagesTotal = m_device->getProperty("num-enroll-stages").onInterface(kDeviceInterface).get<std::int32_t>();
+    } catch (const sdbus::Error& e) {
+      kLog.debug("could not read num-enroll-stages: {}", e.what());
+      m_stagesTotal = -1;
+    }
+    m_device->callMethodAsync("EnrollStart")
+        .onInterface(kDeviceInterface)
+        .withTimeout(kInteractiveTimeout)
+        .withArguments(finger)
+        .uponReplyInvoke([this, alive = std::weak_ptr<void>(m_alive)](std::optional<sdbus::Error> e) {
+          if (alive.expired()) {
+            return;
+          }
+          if (e.has_value()) {
+            kLog.info("could not start enrollment: {}", e->what());
+            setStatus(errorMessage(*e), true);
+            finishOperation();
+            return;
+          }
+          if (m_mode == Mode::Enrolling) {
+            setStatus(touchPrompt(m_devices, m_selectedPath), false);
+          }
+        });
+  });
+  notifyChanged();
+}
+
+void FingerprintManager::handleEnrollStatus(const std::string& result, bool done) {
+  if (m_mode != Mode::Enrolling) {
+    return;
+  }
+  kLog.debug("enroll status: {} (done={})", result, done);
+  constexpr std::string_view kPrefix = "enroll-";
+  const std::string_view suffix =
+      std::string_view(result).starts_with(kPrefix) ? std::string_view(result).substr(kPrefix.size()) : result;
+
+  if (suffix == "completed") {
+    m_enrollCompleted = true;
+    if (m_stagesTotal > 0) {
+      m_stagesDone = m_stagesTotal;
+    }
+    if (!std::ranges::contains(m_enrolled, m_enrollFinger)) {
+      m_enrolled.push_back(m_enrollFinger);
+    }
+    setStatus(i18n::tr("settings.fingerprint.status.enroll-completed"), false);
+  } else if (suffix == "stage-passed") {
+    ++m_stagesDone;
+    setStatus(i18n::tr("settings.fingerprint.status.stage-passed"), false);
+  } else if (const auto retry = retryMessage(suffix)) {
+    setStatus(*retry, false);
+  } else if (suffix == "duplicate") {
+    setStatus(i18n::tr("settings.fingerprint.status.duplicate"), true);
+  } else if (suffix == "data-full") {
+    setStatus(i18n::tr("settings.fingerprint.status.data-full"), true);
+  } else if (suffix == "disconnected") {
+    setStatus(i18n::tr("settings.fingerprint.status.disconnected"), true);
+  } else {
+    // enroll-failed, enroll-unknown-error and anything newer than this code.
+    setStatus(i18n::tr("settings.fingerprint.status.enroll-failed"), true);
+  }
+
+  if (!done) {
+    notifyChanged();
+    return;
+  }
+  if (m_device != nullptr) {
+    m_device->callMethodAsync("EnrollStop")
+        .onInterface(kDeviceInterface)
+        .uponReplyInvoke([](std::optional<sdbus::Error>) {});
+  }
+  finishOperation();
+}
+
+void FingerprintManager::startVerify() {
+  if (busy()) {
+    return;
+  }
+  m_mode = Mode::Verifying;
+  m_matchedFinger.clear();
+  m_enrollCompleted = false;
+  setStatus(i18n::tr("settings.fingerprint.status.preparing"), false);
+
+  claimThen([this]() {
+    m_device->callMethodAsync("VerifyStart")
+        .onInterface(kDeviceInterface)
+        .withTimeout(kInteractiveTimeout)
+        .withArguments(std::string{"any"})
+        .uponReplyInvoke([this, alive = std::weak_ptr<void>(m_alive)](std::optional<sdbus::Error> e) {
+          if (alive.expired()) {
+            return;
+          }
+          if (e.has_value()) {
+            kLog.info("could not start verification: {}", e->what());
+            setStatus(errorMessage(*e), true);
+            finishOperation();
+            return;
+          }
+          if (m_mode != Mode::Verifying) {
+            return;
+          }
+          setStatus(touchPrompt(m_devices, m_selectedPath), false);
+          m_verifyTimeout.start(kVerifyTimeout, [this]() {
+            if (m_mode != Mode::Verifying) {
+              return;
+            }
+            cancel();
+            setStatus(i18n::tr("settings.fingerprint.status.verify-timeout"), true);
+          });
+        });
+  });
+  notifyChanged();
+}
+
+void FingerprintManager::handleVerifyStatus(const std::string& result, bool done) {
+  if (m_mode != Mode::Verifying) {
+    return;
+  }
+  kLog.debug("verify status: {} (done={})", result, done);
+  constexpr std::string_view kPrefix = "verify-";
+  const std::string_view suffix =
+      std::string_view(result).starts_with(kPrefix) ? std::string_view(result).substr(kPrefix.size()) : result;
+
+  if (suffix == "match") {
+    if (m_matchedFinger.empty()) {
+      m_matchedFinger = "any";
+    }
+    if (m_matchedFinger == "any") {
+      setStatus(i18n::tr("settings.fingerprint.status.match"), false);
+    } else {
+      setStatus(i18n::tr("settings.fingerprint.status.match-finger", "finger", fingerLabel(m_matchedFinger)), false);
+    }
+  } else if (suffix == "no-match") {
+    m_matchedFinger.clear();
+    setStatus(i18n::tr("settings.fingerprint.status.no-match"), true);
+  } else if (const auto retry = retryMessage(suffix)) {
+    setStatus(*retry, false);
+  } else if (suffix == "disconnected") {
+    m_matchedFinger.clear();
+    setStatus(i18n::tr("settings.fingerprint.status.disconnected"), true);
+  } else {
+    m_matchedFinger.clear();
+    setStatus(i18n::tr("settings.fingerprint.status.verify-failed"), true);
+  }
+
+  if (!done) {
+    notifyChanged();
+    return;
+  }
+  if (m_device != nullptr) {
+    m_device->callMethodAsync("VerifyStop")
+        .onInterface(kDeviceInterface)
+        .uponReplyInvoke([](std::optional<sdbus::Error>) {});
+  }
+  finishOperation();
+}
+
+void FingerprintManager::cancel() {
+  if (m_mode == Mode::Idle && !m_claiming) {
+    return;
+  }
+  const Mode mode = m_mode;
+  m_verifyTimeout.stop();
+  m_mode = Mode::Idle;
+  if (m_device != nullptr && m_claimed) {
+    const char* stop = mode == Mode::Enrolling ? "EnrollStop" : "VerifyStop";
+    m_device->callMethodAsync(stop).onInterface(kDeviceInterface).uponReplyInvoke([](std::optional<sdbus::Error>) {});
+  }
+  release();
+  if (mode == Mode::Enrolling && !m_enrollCompleted) {
+    m_enrollFinger.clear();
+  }
+  clearStatus();
+  notifyChanged();
+}
+
+void FingerprintManager::clearStatus() {
+  m_status.clear();
+  m_statusError = false;
+  m_matchedFinger.clear();
+}
+
+void FingerprintManager::resetEnrollment() {
+  if (m_mode == Mode::Enrolling) {
+    return;
+  }
+  m_enrollFinger.clear();
+  m_stagesDone = 0;
+  m_stagesTotal = -1;
+  m_enrollCompleted = false;
+  clearStatus();
+}
+
+void FingerprintManager::setStatus(std::string message, bool error) {
+  m_status = std::move(message);
+  m_statusError = error;
+  notifyChanged();
+}
+
+void FingerprintManager::notifyChanged() {
+  if (m_onChanged) {
+    m_onChanged();
+  }
+}
+
+const std::vector<std::string>& FingerprintManager::selectableFingers() {
+  static const std::vector<std::string> kFingers = {
+      "right-thumb", "right-index-finger", "right-middle-finger",
+      "left-thumb",  "left-index-finger",  "left-middle-finger",
+  };
+  return kFingers;
+}
+
+std::string FingerprintManager::fingerLabel(std::string_view finger) {
+  static const std::map<std::string, std::string, std::less<>> kKeys = {
+      {"left-thumb", "settings.fingerprint.finger.left-thumb"},
+      {"left-index-finger", "settings.fingerprint.finger.left-index"},
+      {"left-middle-finger", "settings.fingerprint.finger.left-middle"},
+      {"left-ring-finger", "settings.fingerprint.finger.left-ring"},
+      {"left-little-finger", "settings.fingerprint.finger.left-little"},
+      {"right-thumb", "settings.fingerprint.finger.right-thumb"},
+      {"right-index-finger", "settings.fingerprint.finger.right-index"},
+      {"right-middle-finger", "settings.fingerprint.finger.right-middle"},
+      {"right-ring-finger", "settings.fingerprint.finger.right-ring"},
+      {"right-little-finger", "settings.fingerprint.finger.right-little"},
+  };
+  const auto it = kKeys.find(finger);
+  return it == kKeys.end() ? std::string(finger) : i18n::tr(it->second);
+}
diff --git a/src/security/fingerprint_manager.h b/src/security/fingerprint_manager.h
new file mode 100644
index 000000000..01941e252
--- /dev/null
+++ b/src/security/fingerprint_manager.h
@@ -0,0 +1,117 @@
+#pragma once
+
+#include "core/timer_manager.h"
+
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+class SystemBus;
+
+namespace sdbus {
+  class IProxy;
+} // namespace sdbus
+
+struct FingerprintDevice {
+  std::string path;
+  std::string name;
+  std::string scanType; // "press" or "swipe"
+};
+
+// Manages the current user's enrolled fingerprints through fprintd's D-Bus API: lists the
+// readers, enrolls, verifies and deletes prints on the selected one. The fprintd CLI tools only
+// ever enroll and verify on the default (first) reader, so reader selection needs D-Bus.
+// All state lives here so the settings page, rebuilt on every change, can stay stateless.
+class FingerprintManager {
+public:
+  enum class Mode { Idle, Enrolling, Verifying };
+
+  using ChangedCallback = std::function<void()>;
+
+  explicit FingerprintManager(SystemBus& bus);
+  ~FingerprintManager();
+
+  FingerprintManager(const FingerprintManager&) = delete;
+  FingerprintManager& operator=(const FingerprintManager&) = delete;
+
+  void setChangedCallback(ChangedCallback callback);
+
+  // Whether fprintd is installed (running or D-Bus activatable).
+  [[nodiscard]] bool serviceAvailable();
+  // Re-reads the readers and the selected reader's enrolled fingers.
+  void refresh();
+  [[nodiscard]] bool loaded() const noexcept { return m_loaded; }
+  [[nodiscard]] bool loading() const noexcept { return m_loading; }
+
+  [[nodiscard]] const std::vector<FingerprintDevice>& devices() const noexcept { return m_devices; }
+  [[nodiscard]] const std::string& selectedDevice() const noexcept { return m_selectedPath; }
+  void selectDevice(const std::string& path);
+  [[nodiscard]] const std::vector<std::string>& enrolledFingers() const noexcept { return m_enrolled; }
+
+  void deleteFinger(const std::string& finger);
+  void startEnroll(const std::string& finger);
+  void startVerify();
+  // Stops a running enroll/verify and releases the reader.
+  void cancel();
+  // Clears the outcome of the last enroll/verify (status line, matched finger).
+  void clearStatus();
+  // Forgets a finished enrollment so the enroll sheet starts at the finger picker again.
+  void resetEnrollment();
+
+  [[nodiscard]] Mode mode() const noexcept { return m_mode; }
+  [[nodiscard]] bool busy() const noexcept { return m_mode != Mode::Idle || m_claiming; }
+  [[nodiscard]] const std::string& enrollFinger() const noexcept { return m_enrollFinger; }
+  [[nodiscard]] int enrollStagesDone() const noexcept { return m_stagesDone; }
+  // -1 when the driver does not report it.
+  [[nodiscard]] int enrollStagesTotal() const noexcept { return m_stagesTotal; }
+  [[nodiscard]] bool enrollCompleted() const noexcept { return m_enrollCompleted; }
+  // Finger recognized by the last verify; "any" when the reader does not tell which one.
+  [[nodiscard]] const std::string& matchedFinger() const noexcept { return m_matchedFinger; }
+  [[nodiscard]] const std::string& status() const noexcept { return m_status; }
+  [[nodiscard]] bool statusIsError() const noexcept { return m_statusError; }
+
+  // fprintd finger names offered for enrollment, right hand first (thumb, index, middle), like
+  // GNOME Settings.
+  [[nodiscard]] static const std::vector<std::string>& selectableFingers();
+  [[nodiscard]] static std::string fingerLabel(std::string_view finger);
+
+private:
+  bool ensureDeviceProxy();
+  void loadEnrolled();
+  void claimThen(std::function<void()> next);
+  void release();
+  void finishOperation();
+  void handleEnrollStatus(const std::string& result, bool done);
+  void handleVerifyStatus(const std::string& result, bool done);
+  void setStatus(std::string message, bool error);
+  void notifyChanged();
+  void dropDeviceProxyLater();
+
+  SystemBus& m_bus;
+  std::unique_ptr<sdbus::IProxy> m_manager;
+  std::unique_ptr<sdbus::IProxy> m_device;
+  std::shared_ptr<void> m_alive = std::make_shared<int>(0);
+  ChangedCallback m_onChanged;
+  Timer m_verifyTimeout;
+
+  std::optional<bool> m_serviceAvailable;
+  bool m_loaded = false;
+  bool m_loading = false;
+  std::vector<FingerprintDevice> m_devices;
+  std::string m_selectedPath;
+  std::vector<std::string> m_enrolled;
+
+  Mode m_mode = Mode::Idle;
+  bool m_claimed = false;
+  bool m_claiming = false;
+  std::string m_enrollFinger;
+  int m_stagesDone = 0;
+  int m_stagesTotal = -1;
+  bool m_enrollCompleted = false;
+  std::string m_matchedFinger;
+  std::string m_status;
+  bool m_statusError = false;
+};
diff --git a/src/security/security_hardware_parsers.cpp b/src/security/security_hardware_parsers.cpp
new file mode 100644
index 000000000..8e01ea020
--- /dev/null
+++ b/src/security/security_hardware_parsers.cpp
@@ -0,0 +1,732 @@
+#include "security/security_hardware_parsers.h"
+
+#include "util/base64.h"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <charconv>
+#include <filesystem>
+#include <regex>
+#include <set>
+#include <sodium.h>
+
+namespace security_hw {
+
+  namespace {
+
+    // The first line of every drop-in this page writes; a drop-in without it is left alone.
+    constexpr std::string_view kDropInMarker =
+        "# Written by Noctalia (Settings > Security); remove this line to keep your edits.";
+    // What the lbssousa/security-hardware plugin wrote before this page took over: still ours.
+    constexpr std::string_view kLegacyDropInMarker =
+        "# Written by the Noctalia security-hardware plugin (lbssousa/security-hardware); remove this line to keep "
+        "your edits.";
+    constexpr std::string_view kIdentity = "    IdentityFile ~/.ssh/";
+
+    constexpr std::array<std::pair<std::string_view, std::string_view>, 2> kSkKeyTypes{{
+        {"sk-ssh-ed25519@openssh.com", "ed25519-sk"},
+        {"sk-ecdsa-sha2-nistp256@openssh.com", "ecdsa-sk"},
+    }};
+
+    constexpr std::array<std::string_view, 8> kGitHosts{
+        "github.com", "gitlab.com",        "bitbucket.org",     "codeberg.org",
+        "git.sr.ht",  "gitea.com",         "ssh.dev.azure.com", "vs-ssh.visualstudio.com",
+    };
+
+    // libfido2's error names, as pamu2fcfg, fido2-token and ssh-keygen print them.
+    constexpr std::array<std::pair<std::string_view, std::string_view>, 18> kFidoErrors{{
+        {"PIN_INVALID", "pin-invalid"},
+        {"PIN incorrect", "pin-invalid"},
+        {"PIN_AUTH_BLOCKED", "pin-blocked"},
+        {"PIN_BLOCKED", "pin-blocked"},
+        {"Too many incorrect PINs", "pin-blocked"},
+        {"PIN_REQUIRED", "pin-required"},
+        {"pin required", "pin-required"},
+        {"failed to read pin", "pin-required"},
+        {"couldn't read PIN", "pin-required"},
+        {"ACTION_TIMEOUT", "timeout"},
+        {"USER_ACTION_TIMEOUT", "timeout"},
+        {"No device found", "no-device"},
+        {"No FIDO SecurityKeyProvider", "no-device"},
+        {"device not found", "no-device"},
+        {"fido_dev_open", "no-device"},
+        {"No keys to download", "ssh-none"},
+        {"no keys found", "ssh-none"},
+        {"returned no keys", "ssh-none"},
+    }};
+
+    std::string_view trim(std::string_view text) {
+      const auto first = text.find_first_not_of(" \t\r\n");
+      if (first == std::string_view::npos) {
+        return {};
+      }
+      const auto last = text.find_last_not_of(" \t\r\n");
+      return text.substr(first, last - first + 1);
+    }
+
+    std::vector<std::string> splitOn(std::string_view text, char separator) {
+      std::vector<std::string> parts;
+      std::size_t start = 0;
+      while (true) {
+        const auto end = text.find(separator, start);
+        parts.emplace_back(text.substr(start, end == std::string_view::npos ? std::string_view::npos : end - start));
+        if (end == std::string_view::npos) {
+          return parts;
+        }
+        start = end + 1;
+      }
+    }
+
+    std::vector<std::string> splitWhitespace(std::string_view text) {
+      std::vector<std::string> out;
+      std::size_t i = 0;
+      while (i < text.size()) {
+        while (i < text.size() && std::isspace(static_cast<unsigned char>(text[i])) != 0) {
+          ++i;
+        }
+        const std::size_t start = i;
+        while (i < text.size() && std::isspace(static_cast<unsigned char>(text[i])) == 0) {
+          ++i;
+        }
+        if (i > start) {
+          out.emplace_back(text.substr(start, i - start));
+        }
+      }
+      return out;
+    }
+
+    // Python's str.splitlines() for the texts here: every line, empty ones included.
+    std::vector<std::string> allLines(std::string_view text) {
+      std::vector<std::string> out;
+      std::size_t start = 0;
+      while (start < text.size()) {
+        auto end = text.find('\n', start);
+        if (end == std::string_view::npos) {
+          end = text.size();
+        }
+        std::string line(text.substr(start, end - start));
+        if (!line.empty() && line.back() == '\r') {
+          line.pop_back();
+        }
+        out.push_back(std::move(line));
+        start = end + 1;
+      }
+      return out;
+    }
+
+    std::optional<std::string_view> skKeyType(std::string_view name) {
+      for (const auto& [wire, type] : kSkKeyTypes) {
+        if (wire == name) {
+          return type;
+        }
+      }
+      return std::nullopt;
+    }
+
+    std::string_view algorithmFilePart(std::string_view algorithm) {
+      if (algorithm == "ed25519-sk") {
+        return "ed25519_sk";
+      }
+      if (algorithm == "ecdsa-sk") {
+        return "ecdsa_sk";
+      }
+      return {};
+    }
+
+    // Reads the SSH wire format's length-prefixed strings.
+    class WireReader {
+    public:
+      explicit WireReader(const Bytes& data, std::size_t at = 0) : m_data(data), m_at(at) {}
+
+      std::optional<Bytes> string() {
+        if (m_at + 4 > m_data.size()) {
+          return std::nullopt;
+        }
+        const std::size_t length = (static_cast<std::size_t>(m_data[m_at]) << 24U)
+            | (static_cast<std::size_t>(m_data[m_at + 1]) << 16U) | (static_cast<std::size_t>(m_data[m_at + 2]) << 8U)
+            | static_cast<std::size_t>(m_data[m_at + 3]);
+        const std::size_t begin = m_at + 4;
+        if (length > m_data.size() - begin) {
+          return std::nullopt;
+        }
+        m_at = begin + length;
+        return Bytes(m_data.begin() + static_cast<std::ptrdiff_t>(begin), m_data.begin() + static_cast<std::ptrdiff_t>(m_at));
+      }
+
+      bool skip(std::size_t count) {
+        if (count > m_data.size() - m_at) {
+          return false;
+        }
+        m_at += count;
+        return true;
+      }
+
+      [[nodiscard]] std::size_t position() const noexcept { return m_at; }
+      [[nodiscard]] bool atEnd() const noexcept { return m_at == m_data.size(); }
+
+    private:
+      const Bytes& m_data;
+      std::size_t m_at;
+    };
+
+    std::string asText(const Bytes& bytes) { return {bytes.begin(), bytes.end()}; }
+
+    bool isAscii(const Bytes& bytes) {
+      return std::ranges::all_of(bytes, [](std::uint8_t c) { return c < 0x80; });
+    }
+
+    std::string dropInWith(
+        std::string_view marker, const std::vector<std::string>& names, const GitRemote& remote,
+        std::optional<int> minutes
+    ) {
+      std::vector<std::string> sorted = names;
+      std::ranges::sort(sorted);
+      std::string text(marker);
+      text += "\nHost " + remote.host + "\n    User " + remote.login + "\n";
+      if (!remote.port.empty()) {
+        text += "    Port " + remote.port + "\n";
+      }
+      for (const auto& name : sorted) {
+        text += std::string(kIdentity) + name + "\n";
+      }
+      text += "    IdentitiesOnly yes\n    IdentityAgent none\n";
+      if (minutes.has_value() && *minutes != 0) {
+        text += "    ControlMaster auto\n    ControlPath ~/.ssh/" + std::string(kControlDir) + "/%C\n    ControlPersist "
+            + std::to_string(*minutes) + "m\n";
+      } else if (minutes.has_value()) {
+        text += "    ControlMaster no\n    ControlPath none\n    ControlPersist no\n";
+      }
+      return text;
+    }
+
+    std::optional<int> parseInt(std::string_view text) {
+      int value = 0;
+      const auto* end = text.data() + text.size();
+      const auto [ptr, ec] = std::from_chars(text.data(), end, value);
+      if (ec != std::errc{} || ptr != end) {
+        return std::nullopt;
+      }
+      return value;
+    }
+
+  } // namespace
+
+  std::vector<std::string> splitLines(std::string_view text) {
+    std::vector<std::string> out;
+    for (auto& line : allLines(text)) {
+      if (!line.empty()) {
+        out.push_back(std::move(line));
+      }
+    }
+    return out;
+  }
+
+  std::string lastLine(std::string_view text) {
+    std::string last;
+    for (const auto& line : allLines(text)) {
+      const auto trimmed = trim(line);
+      if (!trimmed.empty()) {
+        last = trimmed;
+      }
+    }
+    return last;
+  }
+
+  std::optional<Bytes> decodeBase64Strict(std::string_view text) {
+    if (text.size() % 4 != 0) {
+      return std::nullopt;
+    }
+    std::size_t padding = 0;
+    for (std::size_t i = 0; i < text.size(); ++i) {
+      const char c = text[i];
+      if (c == '=') {
+        if (i + 2 < text.size()) {
+          return std::nullopt;
+        }
+        ++padding;
+        continue;
+      }
+      if (padding > 0 || Base64::kChars.find(c) == std::string_view::npos) {
+        return std::nullopt;
+      }
+    }
+    return Base64::decode(text);
+  }
+
+  // -- FIDO2/U2F --------------------------------------------------------------------------------
+
+  std::vector<FidoDevice> parseFidoDevices(std::string_view text) {
+    std::vector<FidoDevice> devices;
+    for (const auto& line : splitLines(text)) {
+      const auto sep = line.find(": ");
+      if (sep == std::string::npos || line.empty() || line.front() != '/') {
+        continue;
+      }
+      FidoDevice device;
+      device.path = line.substr(0, sep);
+      const std::string rest = line.substr(sep + 2);
+      const auto trimmed = trim(rest);
+      const auto open = trimmed.find('(');
+      if (!trimmed.empty() && trimmed.back() == ')' && open != std::string_view::npos) {
+        device.name = std::string(trimmed.substr(open + 1, trimmed.size() - open - 2));
+      } else {
+        device.name = std::string(trimmed);
+      }
+      devices.push_back(std::move(device));
+    }
+    return devices;
+  }
+
+  void applyFidoInfo(FidoDevice& device, std::string_view text) {
+    device.residentKeys = false;
+    device.clientPin = false;
+    device.pinRetries = -1;
+    for (const auto& line : splitLines(text)) {
+      const auto colon = line.find(':');
+      const auto key = trim(std::string_view(line).substr(0, colon));
+      const auto value = colon == std::string::npos ? std::string_view{} : std::string_view(line).substr(colon + 1);
+      if (key == "options") {
+        for (const auto& option : splitOn(value, ',')) {
+          const auto name = trim(option);
+          if (name == "rk") {
+            device.residentKeys = true;
+          } else if (name == "clientPin") {
+            device.clientPin = true;
+          }
+        }
+      } else if (key == "pin retries") {
+        if (const auto retries = parseInt(trim(value))) {
+          device.pinRetries = *retries;
+        }
+      }
+    }
+  }
+
+  std::vector<std::string> credentialHandles(std::string_view line, std::string_view user) {
+    std::vector<std::string> out;
+    if (!line.starts_with(user) || line.size() <= user.size() || line[user.size()] != ':') {
+      return out;
+    }
+    for (auto& credential : splitOn(line.substr(user.size() + 1), ':')) {
+      if (!credential.empty()) {
+        out.push_back(std::move(credential));
+      }
+    }
+    return out;
+  }
+
+  std::string credentialKeyHandle(std::string_view credential) {
+    return std::string(credential.substr(0, credential.find(',')));
+  }
+
+  std::string credentialLabel(std::string_view credential) { return credentialKeyHandle(credential).substr(0, 10); }
+
+  std::vector<std::string>
+  mergeCredentials(const std::vector<std::string>& existing, const std::vector<std::string>& added) {
+    std::vector<std::string> merged = existing;
+    std::set<std::string> handles;
+    for (const auto& credential : existing) {
+      handles.insert(credentialKeyHandle(credential));
+    }
+    for (const auto& credential : added) {
+      const auto handle = credentialKeyHandle(credential);
+      if (!handle.empty() && handles.insert(handle).second) {
+        merged.push_back(credential);
+      }
+    }
+    return merged;
+  }
+
+  PamU2f parsePamU2f(std::string_view text) {
+    for (const auto& raw : splitLines(text)) {
+      const auto line = trim(raw);
+      if (line.starts_with('#') || line.find("pam_u2f.so") == std::string_view::npos) {
+        continue;
+      }
+      PamU2f state{.u2f = true};
+      for (const auto& word : splitWhitespace(line)) {
+        if (word.starts_with("authfile=")) {
+          state.authfile = word.substr(9);
+        } else if (word == "pinverification=1") {
+          state.pin = true;
+        }
+      }
+      return state;
+    }
+    return {};
+  }
+
+  namespace {
+    std::string normalizePath(std::string_view path) {
+      return std::filesystem::path(path).lexically_normal().string();
+    }
+  } // namespace
+
+  bool pamUsesFile(const std::vector<PamU2f>& services, std::string_view path, std::string_view own) {
+    const auto wanted = normalizePath(path);
+    return std::ranges::any_of(services, [&](const PamU2f& s) {
+      return s.u2f && normalizePath(s.authfile.empty() ? own : s.authfile) == wanted;
+    });
+  }
+
+  FidoTarget fidoTarget(const std::vector<PamU2f>& services, std::string_view ownAuthfile) {
+    std::set<std::string> paths;
+    for (const auto& service : services) {
+      if (service.u2f) {
+        paths.insert(normalizePath(service.authfile.empty() ? ownAuthfile : service.authfile));
+      }
+    }
+    if (paths.empty()) {
+      return {.kind = FidoTargetKind::NoPam};
+    }
+    if (paths.size() > 1) {
+      return {.kind = FidoTargetKind::Mixed};
+    }
+    const std::string path = *paths.begin();
+    return {
+        .kind = path == normalizePath(ownAuthfile) ? FidoTargetKind::Own : FidoTargetKind::OtherFile,
+        .path = path,
+    };
+  }
+
+  std::string fidoErrorCode(std::string_view text, bool pinGiven) {
+    // Asked for a PIN it wasn't given (pamu2fcfg then fails on the empty one).
+    if (!pinGiven && text.find("Enter PIN") != std::string_view::npos) {
+      return "pin-required";
+    }
+    for (const auto& [needle, code] : kFidoErrors) {
+      if (text.find(needle) != std::string_view::npos) {
+        return std::string(code);
+      }
+    }
+    return "generic";
+  }
+
+  // -- OpenPGP ----------------------------------------------------------------------------------
+
+  bool secretOnDisk(std::string_view colons) {
+    for (const auto& line : splitLines(colons)) {
+      const auto fields = splitOn(line, ':');
+      if (fields.front() == "sec" || fields.front() == "ssb") {
+        const std::string token = fields.size() > 14 ? fields[14] : std::string{};
+        if (token.empty() || token == "+") {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+  std::string formatFingerprint(std::string_view fpr) {
+    std::string hex(fpr);
+    std::ranges::transform(hex, hex.begin(), [](char c) { return static_cast<char>(std::toupper(static_cast<unsigned char>(c))); });
+    if (hex.size() != 40) {
+      return hex;
+    }
+    std::string out;
+    for (std::size_t i = 0; i < 40; i += 4) {
+      if (i == 20) {
+        out += "  ";
+      } else if (i > 0) {
+        out += ' ';
+      }
+      out += hex.substr(i, 4);
+    }
+    return out;
+  }
+
+  // -- Resident SSH keys ------------------------------------------------------------------------
+
+  std::optional<SkPublic> parseSkPublic(std::string_view text) {
+    const auto fields = splitWhitespace(text);
+    if (fields.size() < 2) {
+      return std::nullopt;
+    }
+    const auto declared = skKeyType(fields[0]);
+    if (!declared) {
+      return std::nullopt;
+    }
+    auto blob = decodeBase64Strict(fields[1]);
+    if (!blob) {
+      return std::nullopt;
+    }
+    WireReader reader(*blob);
+    const auto name = reader.string();
+    if (!name || !isAscii(*name)) {
+      return std::nullopt;
+    }
+    const auto type = skKeyType(asText(*name));
+    if (!type || *type != *declared) {
+      return std::nullopt;
+    }
+    if (*type == "ecdsa-sk" && !reader.string()) { // the curve
+      return std::nullopt;
+    }
+    if (!reader.string()) { // the point
+      return std::nullopt;
+    }
+    const auto application = reader.string();
+    if (!application || !reader.atEnd() || !isAscii(*application)) {
+      return std::nullopt;
+    }
+    return SkPublic{.type = std::string(*type), .application = asText(*application), .blob = std::move(*blob)};
+  }
+
+  std::string sshFingerprint(const Bytes& blob) {
+    std::array<unsigned char, crypto_hash_sha256_BYTES> digest{};
+    crypto_hash_sha256(digest.data(), blob.data(), blob.size());
+    std::string encoded = Base64::encode(digest.data(), digest.size());
+    while (!encoded.empty() && encoded.back() == '=') {
+      encoded.pop_back();
+    }
+    return "SHA256:" + encoded;
+  }
+
+  std::optional<SkHandle> parseSkHandle(std::string_view text) {
+    constexpr std::string_view kBegin = "-----BEGIN OPENSSH PRIVATE KEY-----";
+    constexpr std::string_view kEnd = "-----END OPENSSH PRIVATE KEY-----";
+    const auto begin = text.find(kBegin);
+    if (begin == std::string_view::npos) {
+      return std::nullopt;
+    }
+    const auto bodyStart = begin + kBegin.size();
+    const auto end = text.find(kEnd, bodyStart);
+    if (end == std::string_view::npos) {
+      return std::nullopt;
+    }
+    std::string body;
+    for (const auto& part : splitWhitespace(text.substr(bodyStart, end - bodyStart))) {
+      body += part;
+    }
+    const auto data = decodeBase64Strict(body);
+    constexpr std::string_view kMagic("openssh-key-v1\0", 15);
+    if (!data || data->size() < kMagic.size() || !std::equal(kMagic.begin(), kMagic.end(), data->begin())) {
+      return std::nullopt;
+    }
+    WireReader reader(*data, kMagic.size());
+    const auto cipher = reader.string();
+    if (!cipher || !reader.string() || !reader.string()) { // the KDF name and options
+      return std::nullopt;
+    }
+    const std::size_t at = reader.position();
+    if (at + 4 > data->size() || (*data)[at] != 0 || (*data)[at + 1] != 0 || (*data)[at + 2] != 0
+        || (*data)[at + 3] != 1) {
+      return std::nullopt; // exactly one key
+    }
+    (void)reader.skip(4);
+    auto blob = reader.string();
+    const auto priv = reader.string();
+    if (!blob || !priv) {
+      return std::nullopt;
+    }
+    if (asText(*cipher) != "none") {
+      return SkHandle{.blob = std::move(*blob), .encrypted = true, .credential = {}};
+    }
+    // Two check integers, then the key: its type, the public part, the application, the flags
+    // byte and the key handle (the credential ID).
+    if (priv->size() < 8 || !std::equal(priv->begin(), priv->begin() + 4, priv->begin() + 4)) {
+      return std::nullopt;
+    }
+    WireReader key(*priv, 8);
+    const auto name = key.string();
+    if (!name || !isAscii(*name)) {
+      return std::nullopt;
+    }
+    const auto type = skKeyType(asText(*name));
+    if (!type) {
+      return std::nullopt;
+    }
+    if (*type == "ecdsa-sk" && !key.string()) {
+      return std::nullopt;
+    }
+    if (!key.string() || !key.string() || !key.skip(1)) { // point, application, flags
+      return std::nullopt;
+    }
+    auto credential = key.string();
+    if (!credential || credential->empty()) {
+      return std::nullopt;
+    }
+    return SkHandle{.blob = std::move(*blob), .encrypted = false, .credential = std::move(*credential)};
+  }
+
+  std::vector<TokenCredential> parseTokenCredentials(std::string_view text) {
+    static const std::regex kCredentialId("[A-Za-z0-9+/]{16,1024}={0,2}");
+    std::vector<TokenCredential> found;
+    for (const auto& line : splitLines(text)) {
+      const auto fields = splitWhitespace(line);
+      if (fields.size() < 5 || !fields[0].ends_with(':') || !std::regex_match(fields[1], kCredentialId)) {
+        continue;
+      }
+      if (auto raw = decodeBase64Strict(fields[1])) {
+        found.push_back({.id = fields[1], .raw = std::move(*raw)});
+      }
+    }
+    return found;
+  }
+
+  bool isResidentKeyName(std::string_view name) {
+    static const std::regex kResident("^id_\\w+_sk_rk");
+    return !name.ends_with(".pub") && std::regex_search(name.begin(), name.end(), kResident);
+  }
+
+  std::string residentKeyName(std::string_view algorithm, std::string_view application, std::string_view user) {
+    std::string suffix(application);
+    if (!user.empty()) {
+      suffix += suffix.empty() ? std::string(user) : "_" + std::string(user);
+    }
+    return "id_" + std::string(algorithmFilePart(algorithm)) + "_rk" + (suffix.empty() ? "" : "_" + suffix);
+  }
+
+  std::string residentKeyUser(std::string_view name, std::string_view keyType, std::string_view application) {
+    const auto part = algorithmFilePart(keyType);
+    if (part.empty()) {
+      return {};
+    }
+    const std::string prefix = "id_" + std::string(part) + "_rk";
+    if (!name.starts_with(prefix)) {
+      return {};
+    }
+    std::string_view rest = name.substr(prefix.size());
+    const std::string_view app = application.starts_with("ssh:") ? application.substr(4) : application;
+    if (!app.empty()) {
+      if (!rest.starts_with("_") || !rest.substr(1).starts_with(app)) {
+        return {};
+      }
+      rest = rest.substr(app.size() + 1);
+    }
+    return rest.starts_with("_") ? std::string(rest.substr(1)) : std::string{};
+  }
+
+  std::string sshCreateProblem(const SshCreateOptions& options) {
+    static const std::regex kApplication("[A-Za-z0-9](?:[A-Za-z0-9._@:-]{0,126}[A-Za-z0-9])?");
+    static const std::regex kUser("[A-Za-z0-9](?:[A-Za-z0-9._@-]{0,62}[A-Za-z0-9])?");
+    if (algorithmFilePart(options.algorithm).empty()) {
+      return "algorithm";
+    }
+    if (!options.application.empty()
+        && (!std::regex_match(options.application, kApplication) || options.application.find("..") != std::string::npos)) {
+      return "application";
+    }
+    if (!options.user.empty()
+        && (!std::regex_match(options.user, kUser) || options.user.find("..") != std::string::npos)) {
+      return "user";
+    }
+    // ssh-keygen -K would skip a handle named like a public half.
+    if (residentKeyName(options.algorithm, options.application, options.user).ends_with(".pub")) {
+      return "pub-name";
+    }
+    // The .pub file carries the comment; keep it plain ASCII.
+    if (options.comment.size() > 128 || !std::ranges::all_of(options.comment, [](char c) { return c >= ' ' && c <= '~'; })) {
+      return "comment";
+    }
+    return {};
+  }
+
+  std::vector<std::string> sshCreateCommand(const std::string& path, const SshCreateOptions& options) {
+    std::vector<std::string> command{
+        "ssh-keygen", "-t", options.algorithm, "-O", "resident", "-O", "application=ssh:" + options.application,
+    };
+    if (!options.user.empty()) {
+      command.insert(command.end(), {"-O", "user=" + options.user});
+    }
+    if (options.verify) {
+      command.insert(command.end(), {"-O", "verify-required"});
+    }
+    if (!options.touch) {
+      command.insert(command.end(), {"-O", "no-touch-required"});
+    }
+    command.insert(command.end(), {"-C", options.comment, "-N", "", "-f", path});
+    return command;
+  }
+
+  std::optional<GitRemote> gitRemote(std::string_view application) {
+    static const std::regex kGitApplication(
+        "(?://)?(?:([A-Za-z0-9][A-Za-z0-9._-]*)@)?"
+        "([A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+)"
+        "(?::([0-9]{1,5}))?/?"
+    );
+    if (!application.starts_with("ssh:")) {
+      return std::nullopt;
+    }
+    const std::string rest(application.substr(4));
+    std::smatch match;
+    if (!std::regex_match(rest, match, kGitApplication)) {
+      return std::nullopt;
+    }
+    std::string host = match[2].str();
+    std::ranges::transform(host, host.begin(), [](char c) { return static_cast<char>(std::tolower(static_cast<unsigned char>(c))); });
+    std::string port;
+    if (match[3].matched) {
+      const auto value = parseInt(match[3].str());
+      if (!value || *value < 1 || *value > 65535) {
+        return std::nullopt;
+      }
+      port = std::to_string(*value);
+    }
+    bool known = std::ranges::contains(kGitHosts, std::string_view(host));
+    if (!known) {
+      const auto labels = splitOn(host, '.');
+      known = std::any_of(labels.begin(), labels.end() - 1, [](const std::string& label) {
+        return label.find("git") != std::string::npos;
+      });
+    }
+    if (!known) {
+      return std::nullopt;
+    }
+    return GitRemote{.login = match[1].matched ? match[1].str() : "git", .host = std::move(host), .port = port};
+  }
+
+  std::string dropInText(const std::vector<std::string>& names, const GitRemote& remote, std::optional<int> minutes) {
+    return dropInWith(kDropInMarker, names, remote, minutes);
+  }
+
+  bool validPersistMinutes(int minutes) { return minutes >= 0 && minutes <= kMaxPersistMinutes; }
+
+  DropIn parseDropIn(std::string_view text) {
+    const auto lines = allLines(text);
+    if (lines.empty() || (lines.front() != kDropInMarker && lines.front() != kLegacyDropInMarker)) {
+      return {.kind = DropInKind::Foreign};
+    }
+    static const std::regex kMinutes("([1-9][0-9]{0,3})m");
+    DropIn found{.kind = DropInKind::Ours};
+    bool invalidMinutes = false;
+    for (std::size_t i = 1; i < lines.size(); ++i) {
+      const std::string_view line = lines[i];
+      if (line.starts_with("Host ")) {
+        found.remote.host = line.substr(5);
+      } else if (line.starts_with("    User ")) {
+        found.remote.login = line.substr(9);
+      } else if (line.starts_with("    Port ")) {
+        found.remote.port = line.substr(9);
+      } else if (line.starts_with(kIdentity)) {
+        found.names.emplace_back(line.substr(kIdentity.size()));
+      } else if (line.starts_with("    ControlPersist ")) {
+        const std::string value(line.substr(19));
+        std::smatch match;
+        if (value == "no") {
+          found.minutes = 0;
+        } else if (std::regex_match(value, match, kMinutes)) {
+          found.minutes = parseInt(match[1].str());
+        } else {
+          invalidMinutes = true;
+        }
+      }
+    }
+    if (found.remote.host.empty() || found.remote.login.empty() || invalidMinutes
+        || (found.minutes.has_value() && !validPersistMinutes(*found.minutes))
+        || dropInWith(lines.front(), found.names, found.remote, found.minutes) != text) {
+      found.kind = DropInKind::Edited;
+      found.minutes.reset();
+    }
+    return found;
+  }
+
+  bool includesDropIns(std::string_view config) {
+    static const std::regex kInclude("^\\s*include\\s+\\S*config\\.d/", std::regex::icase);
+    return std::ranges::any_of(allLines(config), [](const std::string& line) {
+      return std::regex_search(line, kInclude);
+    });
+  }
+
+} // namespace security_hw
