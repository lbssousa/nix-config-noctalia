+SecurityKeyManager::~SecurityKeyManager() {
+  m_alive.reset();
+  m_probeTimer.stop();
+  if (m_opCancel) {
+    m_opCancel->store(true);
+  }
+  if (m_tester != nullptr) {
+    m_tester->stop();
+  }
+  if (m_workdir.has_value()) {
+    std::error_code ec;
+    std::filesystem::remove_all(*m_workdir, ec);
