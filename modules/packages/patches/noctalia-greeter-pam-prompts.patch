+void GreeterSurface::showPamPrompt(const std::string& prompt, bool secret) {
+  if (m_passwordField == nullptr) {
+    return;
+  }
+  // "New password: " → "New password".
+  std::string_view text = prompt;
+  while (!text.empty() && (text.back() == ' ' || text.back() == ':')) {
+    text.remove_suffix(1);
+  }
+  m_passwordField->setPlaceholder(text.empty() ? kPasswordPlaceholder : text);
+  m_passwordField->setPasswordMode(secret);
+  requestLayout();
+}
+
+void GreeterSurface::restorePasswordPrompt() {
+  if (m_passwordField == nullptr) {
+    return;
+  }
+  m_passwordField->setPlaceholder(kPasswordPlaceholder);
+  m_passwordField->setPasswordMode(true);
+  requestLayout();
+}
