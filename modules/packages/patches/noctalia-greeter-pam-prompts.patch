+  bool passwordSetAtLogin(const uid_t uid) {
+    // accountsservice: 0 = regular, 1 = SetAtLogin, 2 = none.
+    constexpr std::int32_t kPasswordModeSetAtLogin = 1;
+
+    GError* error = nullptr;
+    GDBusConnection* connection = g_bus_get_sync(G_BUS_TYPE_SYSTEM, nullptr, &error);
+    if (connection == nullptr) {
+      if (error != nullptr) {
+        g_error_free(error);
+      }
+      return false;
+    }
+
+    bool setAtLogin = false;
+    if (const auto userObjectPath = userObjectPathForUid(connection, uid)) {
+      if (const auto property = dbusUserProperty(connection, userObjectPath->c_str(), "PasswordMode")) {
+        if (g_variant_is_of_type(*property, G_VARIANT_TYPE_INT32)) {
+          setAtLogin = g_variant_get_int32(*property) == kPasswordModeSetAtLogin;
+        }
+        g_variant_unref(*property);
+      }
+    }
+    g_object_unref(connection);
+    return setAtLogin;
