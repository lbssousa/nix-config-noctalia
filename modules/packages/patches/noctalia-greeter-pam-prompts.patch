+    }
+    if (code == "AUTHTOK_ERR" || code == "AUTHTOK_RECOVERY_ERR") {
+      return "A nova senha foi recusada. Escolha outra.";
+    }
+    if (code == "PERM_DENIED") {
+      return changing ? "A troca de senha não foi permitida." : "Acesso negado.";
+    }
+    if (code == "NEW_AUTHTOK_REQD") {
+      return "Sua senha expirou e precisa ser trocada.";
+    }
+    if (code == "ACCT_EXPIRED") {
+      return "Esta conta expirou.";
+    }
+    if (code == "MAXTRIES") {
+      return "Tentativas demais. Aguarde um pouco e tente de novo.";
+    }
+    if (code == "USER_UNKNOWN") {
+      return "Usuário desconhecido.";
+    }
+    return std::string(description);
